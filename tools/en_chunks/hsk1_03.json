[{"id":51,"hanzi":"饭店","pinyin":"fàn diàn","meaning":"restaurant","idn":["Makanan di restoran ini enak banget.","Ayo kita makan di restoran.","Ada restoran di sini?","Saya kerja di restoran.","Kemarin kami pergi ke restoran itu.","Di restoran ada banyak orang.","Restoran ini mahal nggak?","Besok kita ketemu di restoran.","Dia menunggu teman di restoran.","Restoran itu di mana?"]},{"id":52,"hanzi":"房间","pinyin":"fáng jiān","meaning":"room","idn":["Kamar saya kecil.","Di kamar ada sebuah meja.","Dia sedang membaca di kamar.","Nomor kamarmu berapa?","Kamar ini besar.","Mama sedang tidur di kamar.","Ada TV di kamarnya?","Kami pesan dua kamar.","Kamar ini berapa per hari?","Silakan kembali ke kamarmu."]},{"id":53,"hanzi":"非常","pinyin":"fēi cháng","meaning":"extremely","idn":["Cuaca hari ini sangat bagus.","Senang sekali bisa kenal kamu.","Masakan ini enak banget.","Dia berbahasa Mandarin dengan sangat baik.","Saya sangat kangen rumah.","Film itu sangat bagus.","Ayah beberapa hari ini sibuk banget.","Guru sangat baik kepada kami.","Baju ini mahal sekali.","Aku sangat suka padamu."]},{"id":54,"hanzi":"飞机","pinyin":"fēi jī","meaning":"plane","idn":["Saya naik pesawat ke Beijing.","Pesawatnya jam berapa sampai?","Dia datang naik pesawat.","Bandara di mana?","Besok kami pulang naik pesawat.","Lihat, ada pesawat!","Kamu suka naik pesawat?","Pesawat tiba jam setengah sepuluh.","Berapa harga tiket pesawat ini?","Kakak laki-laki saya kerja di bandara."]},{"id":55,"hanzi":"分","pinyin":"fēn","meaning":"minute; point; part; to divide","idn":["Sekarang jam tiga lewat dua puluh menit.","Lima menit lagi jam delapan.","Kamu dapat nilai berapa di ujian?","Saya dapat nilai sembilan puluh lima.","Apel ini kita makan bagi-bagi.","Sekarang jam enam lima puluh.","Guru memberinya nilai seratus.","Sepuluh menit lagi kelas selesai.","Sampai jumpa jam delapan lewat lima.","Uangnya kita bagi berdua."]},{"id":56,"hanzi":"分钟","pinyin":"fēn zhōng","meaning":"minute","idn":["Tunggu saya sepuluh menit.","Lima menit lagi masuk kelas.","Dari sini ke sekolah butuh dua puluh menit.","Tolong tunggu beberapa menit.","Saya berjalan tiga puluh menit.","Filmenya mulai lima belas menit lagi.","Kamu sudah menunggu berapa menit?","Saya tidak mau menunggu semenit pun.","Naik kereta ke sana butuh satu jam empat puluh menit.","Dia belajar lima puluh menit setiap pagi."]},{"id":57,"hanzi":"高兴","pinyin":"gāo xìng","meaning":"pleased; happy","idn":["Saya hari ini senang.","Senang berkenalan denganmu.","Dia hari ini kurang senang.","Mama senang melihat saya.","Kenapa kamu tidak senang?","Kami semua senang.","Anak laki-lakinya pulang, ayah sangat senang.","Dia tersenyum dengan senang.","Hari ini ulang tahunku, aku senang sekali.","Jangan sedih lagi."]},{"id":58,"hanzi":"歌","pinyin":"gē","meaning":"song","idn":["Lagu ini enak didengar.","Kamu bisa nyanyi lagu ini?","Saya suka dengar lagu Mandarin.","Suaranya bagus saat dia bernyanyi.","Ayo kita nyanyi bareng.","Ini lagu apa?","Anak itu suka menyanyi lagu Inggris.","Dia menyanyikan sebuah lagu untukku.","Lagu ini dinyanyikan siapa?","Siapa yang mengajari kalian lagu ini?"]},{"id":59,"hanzi":"哥哥","pinyin":"gē ge","meaning":"elder brother","idn":["Kakak laki-laki saya dokter.","Kamu punya kakak laki-laki?","Kakak tahun ini umur dua puluh.","Kakak saya bekerja di Beijing.","Kakak suka main bola.","Ini HP kakak.","Saya berangkat sekolah bareng kakak.","Kakak pulang kemarin.","Kakaknya bisa nyetir.","Kakak saya tinggi."]},{"id":60,"hanzi":"个","pinyin":"gè","meaning":"individual; [general measure word]","idn":["Saya punya satu kakak laki-laki.","Ini berapa?","Berapa orang di keluargamu?","Saya mau apel yang itu.","Dia murid yang baik.","Beri saya dua minggu.","Dia membeli HP baru.","Yang mana punyamu?","Tiga bulan lagi saya pergi ke Tiongkok.","Satu-satu ya."]},{"id":61,"hanzi":"给","pinyin":"gěi","meaning":"to give","idn":["Saya telepon kamu.","Tolong beri saya segelas air.","Mama memberiku uang seratus yuan.","Ini untuk siapa?","Dia membelikanku banyak barang.","Bukumu kasih ke saya saja.","Saya sudah meneleponnya.","Siapa yang memberimu ini?","Nih, ini punyamu.","Coba lihatkan."]},{"id":62,"hanzi":"公司","pinyin":"gōng sī","meaning":"company; office","idn":["Saya bekerja di sebuah perusahaan.","Perusahaannya ada di Shanghai.","Jam berapa kamu ke kantor?","Kantor kami ada lima puluh orang.","Ayah sedang rapat di kantor.","Perusahaan ini bagaimana?","Dia hari ini tidak di kantor.","Kantor kami besok libur.","Dia sudah pulang dari kantor.","Kamu mau kerja di perusahaan kami?"]},{"id":63,"hanzi":"工作","pinyin":"gōng zuò","meaning":"job; work","idn":["Saya bekerja di Beijing.","Kamu kerja apa?","Dia dapat pekerjaan baru.","Kerjaannya sibuk, tapi saya suka.","Mama bekerja di rumah sakit.","Hari ini kerjaannya banyak?","Besok kami tidak bekerja.","Dia suka pekerjaannya.","Kamu sudah kerja berapa tahun?","Setelah kerja ayo makan bareng."]},{"id":64,"hanzi":"狗","pinyin":"gǒu","meaning":"dog","idn":["Di rumahku ada seekor anjing.","Anjing ini kecil.","Kamu suka anjing?","Anjingnya ada di kamar.","Anjing itu punya siapa?","Anjingku namanya Xiaobai.","Anjing suka makan daging.","Anjing di rumahnya besar.","Lihat, anjing itu sedang makan.","Anjing kami sudah umur sepuluh tahun."]},{"id":65,"hanzi":"贵","pinyin":"guì","meaning":"expensive","idn":["Ini terlalu mahal.","Mahal nggak?","Baju ini mahal.","Agak mahal, tapi enak banget.","Restoran itu mahal.","Terlalu mahal, saya tidak jadi.","HP ini mahal?","Barangnya tidak mahal, beli saja.","Tiket pesawat mahal.","Sekarang semuanya mahal."]},{"id":66,"hanzi":"国","pinyin":"guó","meaning":"country, nation, state","idn":["Kamu orang negara mana?","Saya ingin pergi ke Tiongkok.","Bulan depan dia pulang ke negaranya.","Dia orang asing, tidak bisa bahasa Mandarin.","Masakan Tiongkok enak.","Kamu pernah ke berapa negara?","Orang-orang di negara ini baik.","Ayah bekerja di Inggris.","Dia pulang ke negaranya untuk menjenguk ibu.","Masakan negara mana yang paling enak?"]},{"id":67,"hanzi":"还","pinyin":"hái","meaning":"still","idn":["Saya masih makan.","Dia belum pulang.","Kamu masih mau?","Saya masih punya satu kakak laki-laki lagi.","Sekarang masih hujan.","Lumayanlah.","Saya mau satu lagi.","Dia belum bangun.","Buku ini belum selesai saya baca.","Sudah jam sembilan, dia masih tidur."]},{"id":68,"hanzi":"孩子","pinyin":"hái zi","meaning":"child; children","idn":["Saya punya dua anak.","Anak-anak sedang tidur.","Anakmu umur berapa?","Dia mengantar anak ke rumah sakit.","Anak kecil semua suka anjing.","Anak itu sedang belajar Mandarin.","Anak-anak ini murid saya.","Jangan biarkan anak main HP.","Anak kami tahun ini umur enam.","Anak laki-laki atau perempuan?"]},{"id":69,"hanzi":"汉语","pinyin":"Hàn yǔ","meaning":"Standard Chinese language","idn":["Saya sedang belajar Mandarin.","Kamu bisa bahasa Mandarin?","Mandarin saya kurang bagus.","Mandarin dia bagus banget.","Saya sudah belajar Mandarin dua tahun.","Guru Mandarin kami baik.","Ini bahasa Mandarinnnya gimana?","Tolong pakai bahasa Mandarin.","Saya suka bahasa Mandarin.","Dia setiap hari belajar Mandarin."]},{"id":70,"hanzi":"汉字","pinyin":"Hàn zì","meaning":"Chinese character","idn":["Hanzi ini cara nulisnya gimana?","Saya tahu huruf ini.","Hanzi agak susah ditulis.","Dia mengenal banyak hanzi.","Silakan tulis pakai hanzi.","Kamu bisa menulis hanzi?","Hanzi ini artinya apa?","Setiap hari menulis dua puluh hanzi.","Hanzi ini saya tidak kenal.","Hanzi itu indah sekali."]},{"id":71,"hanzi":"好","pinyin":"hǎo","meaning":"good","idn":["Halo!","Cuaca hari ini bagus.","Saya baik, terima kasih.","Boleh nggak?","Dia sahabatku.","Kita ketemu jam tiga sore, ya?","Kamu sudah siap?","Oke, begitu saja.","Kalau badan sehat, semuanya baik.","Lama tidak ketemu!"]},{"id":72,"hanzi":"好吃","pinyin":"hǎo chī","meaning":"delicious","idn":["Masakan ini enak.","Masakan mama paling enak.","Menurutmu ini enak nggak?","Pangsitnya enak?","Makanan di sini enak banget.","Ini kurang enak.","Masakan Tiongkok enak sekali!","Apel ini tidak enak.","Masakan apa yang paling enak?","Semua makanan di restoran ini enak."]},{"id":73,"hanzi":"好看","pinyin":"hǎo kàn","meaning":"good-looking","idn":["Film ini bagus.","Dia hari ini cantik banget.","Baju ini bagus nggak?","Bajumu bagus.","Buku itu tidak bagus.","Yang mana yang bagus?","Tempat ini bagus.","Di TV tidak ada yang bagus.","Kakak perempuannya cantik.","Menurutku yang merah bagus."]},{"id":74,"hanzi":"好听","pinyin":"hǎo tīng","meaning":"pleasant to hear","idn":["Lagu ini enak didengar.","Namamu bagus.","Cara dia bicara Mandarin enak didengar.","Lagu ini enak nggak?","Lagu itu tidak enak.","Lagu yang kamu nyanyikan bagus banget!","Menurutku bahasa Mandarin enak didengar.","Lagu yang enak semua saya suka.","Nama ini bagus sekali.","Ucapanmu manis didengar."]},{"id":75,"hanzi":"好玩儿","pinyin":"hǎo wán","meaning":"fun; interesting","idn":["Di sini seru banget.","Menurutmu Beijing seru nggak?","Dia bilang Tiongkok seru.","Di sana ada apa yang seru?","Kemarin kami pergi ke tempat yang seru.","Ini kurang seru.","Main sama anjing kecil itu seru.","Menurutku masak itu seru.","Besok mama mengajakku ke tempat yang seru.","Nyanyi itu seru, kamu ikut juga!"]}]
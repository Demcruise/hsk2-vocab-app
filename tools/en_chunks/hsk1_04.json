[{"id":76,"hanzi":"号","pinyin":"hào","meaning":"number; date; size","idn":["Hari ini tanggal berapa?","Hari ini tanggal delapan Maret.","Nomor HP kamu berapa?","Saya menginap di kamar nomor dua belas.","Kami pulang tanggal lima belas.","Besok tanggal berapa?","Tanggal satu Agustus adalah ulang tahunnya.","Ini ada ukuran kecil?","Dia menunggu kita di meja nomor sembilan.","Sampai jumpa tanggal dua puluh dua."]},{"id":77,"hanzi":"喝","pinyin":"hē","meaning":"to drink","idn":["Saya mau minum air.","Kamu minum apa?","Dia tidak suka minum teh.","Ayo kita ngopi.","Mama menyuruhku banyak minum air.","Dia minum banyak sekali.","Minumlah sedikit air.","Dia sedang minum teh susu.","Sudah jangan minum lagi, ayo pergi.","Pagi-pagi saya minum susu."]},{"id":78,"hanzi":"和","pinyin":"hé","meaning":"and","idn":["Saya dan dia adalah teman.","Saya pergi bareng kakak.","Dia dan saya adalah teman sekelas.","Saya mau teh dan kopi.","Kamu bilang apa padanya?","Apel dan pisang dua-duanya saya suka.","Saya pergi ke toko sama mama.","Hari ini atau besok sama-sama bisa.","Dia tinggal sama siapa?","Dia sedang makan dengan teman."]},{"id":79,"hanzi":"很","pinyin":"hěn","meaning":"very","idn":["Saya baik-baik saja.","Hari ini panas.","Dia cantik.","Ini besar.","Kami semua suka padamu.","Dua hari ini saya sibuk.","Restoran itu mahal.","Bahasa Mandarin susah nggak?","Dia jalan cepat.","Aku sangat merindukanmu."]},{"id":80,"hanzi":"后","pinyin":"hòu","meaning":"queen, empress; behind, after","idn":["Setelah makan kita nonton film.","Sampai jumpa lusa.","Dia di belakangku.","Setahun lagi saya pergi ke Tiongkok.","Sepulang kerja ayo makan bareng.","Setelah makan minum kopi.","Saya pulang lusa.","Dia yang terakhir tiba.","Lalu kita pergi ke rumahmu.","Telepon saya setelah jam delapan."]},{"id":81,"hanzi":"回","pinyin":"huí","meaning":"to return","idn":["Saya pulang jam enam.","Dia sudah pulang ke negaranya.","Kapan kamu kembali?","Ayo kita pulang.","Dia belum kembali.","Saya mau pulang.","Setelah kembali ke Beijing, telepon saya.","Mama menyuruhku pulang lebih awal.","Dia kembali ke kantor.","Tahun depan saya mau pulang."]},{"id":82,"hanzi":"会","pinyin":"huì","meaning":"to know how to; can; meeting","idn":["Saya bisa bahasa Mandarin.","Kamu bisa nyetir?","Besok akan hujan nggak?","Dia tidak akan datang.","Kami sedang rapat.","Kamu bisa masak?","Saya akan kembali.","Sore ini saya ada rapat.","Dia tidak bisa bahasa Inggris.","Sampai jumpa nanti."]},{"id":83,"hanzi":"火车","pinyin":"huǒ chē","meaning":"train","idn":["Kita pergi naik kereta.","Keretanya berangkat jam berapa?","Stasiun kereta di mana?","Saya datang naik kereta.","Di kereta orangnya banyak.","Tiket kereta sudah dibeli?","Kereta ini sampai Shanghai nggak?","Besok dia naik kereta kembali ke Shanghai.","Naik kereta ke sana enam jam.","Kamu naik kereta atau pesawat?"]},{"id":84,"hanzi":"鸡蛋","pinyin":"jī dàn","meaning":"(chicken) egg","idn":["Saya mau satu telur.","Pagi-pagi saya makan telur.","Kamu bisa masak telur?","Telur berapa sekilonya?","Mama membeli sepuluh telur.","Dia tidak makan telur.","Mie telurnya enak nggak?","Ada telur di kulkas?","Telur ini dibeli hari ini.","Anak itu suka makan telur."]},{"id":85,"hanzi":"几","pinyin":"jǐ","meaning":"how much/many? [expecting a small number]","idn":["Kamu umur berapa?","Sekarang jam berapa?","Ada berapa orang di keluargamu?","Hari ini tanggal berapa?","Kamu mau berapa?","Hari apa berangkatnya?","Dia berusia belasan tahun.","Berapa orang bareng-bareng?","Berapa yuan?","Kamu sudah belajar Mandarin berapa tahun?"]},{"id":86,"hanzi":"家","pinyin":"jiā","meaning":"family; home","idn":["Saya kangen rumah.","Saya sudah pulang.","Rumahmu di mana?","Selamat datang di rumahku.","Keluarganya ada tiga orang.","Kita satu keluarga.","Keluarga ini baik.","Saya lagi di rumah.","Siapa yang di rumah?","Dia setiap hari pulang makan di rumah."]},{"id":87,"hanzi":"家人","pinyin":"jiā rén","meaning":"family member","idn":["Saya sangat sayang keluargaku.","Dia sedang bersama keluarga.","Kamu kangen keluarga?","Saya membelikan keluarga banyak barang.","Keluargaku semua tinggal di Shanghai.","Merayakan tahun baru bareng keluarga.","Keluargamu baik-baik?","Ini keluargaku.","Keluarga kami semua suka anjing.","Saya kangen keluargaku."]},{"id":88,"hanzi":"见","pinyin":"jiàn","meaning":"to see, to perceive with the eyes","idn":["Sampai jumpa besok.","Senang bertemu denganmu.","Sampai jumpa lagi.","Saya mau bertemu kamu.","Kamu ketemu dia di mana?","Lama nggak ketemu!","Kita ketemu jam berapa?","Saya mau menemui seorang teman.","Hari ini tidak sempat ketemu kamu.","Sampai jumpa jam delapan malam."]},{"id":89,"hanzi":"件","pinyin":"jiàn","meaning":"item; [measure word for items of clothing]","idn":["Baju ini berapa?","Saya membeli dua baju.","Baju itu bagus.","Kamu mau yang mana?","Ini agak besar.","Hari ini saya ada tiga urusan.","Dia membelikanku sepotong baju.","Ini boleh dicoba?","Yang merah itu bagus.","Beberapa ini semua punyaku."]},{"id":90,"hanzi":"饺子","pinyin":"jiǎo zi","meaning":"dumpling","idn":["Saya suka makan pangsit.","Pangsit buatan mama paling enak.","Kamu pernah makan pangsit Tiongkok?","Ayo kita bikin pangsit bareng.","Hari ini makan pangsit.","Pangsitnya berapa seporsi?","Pangsit di sini enak banget.","Dia makan dua puluh pangsit.","Saat tahun baru kami makan pangsit.","Kamu suka pangsit atau mie?"]},{"id":91,"hanzi":"叫","pinyin":"jiào","meaning":"to call; to be called; to ask","idn":["Siapa namamu?","Namaku Mary.","Dia menyuruhku pergi jam delapan.","Ini dalam bahasa Mandarin namanya apa?","Mama menyuruh kami pulang.","Jangan teriak!","Namanya siapa?","Guru menyuruhku ke tempatnya.","Kamu memanggilku?","Anjing ini namanya apa?"]},{"id":92,"hanzi":"姐姐","pinyin":"jiě jie","meaning":"elder sister","idn":["Kakak perempuanku seorang guru.","Kamu punya kakak perempuan?","Kakak tahun ini umur dua puluh lima.","Saya tinggal bareng kakak.","Kakak sedang masak.","Kakak perempuannya cantik.","Kakak membelikanku baju.","Kakakku tidak suka anjing.","Kakak pulang besok.","Kedua kakakku ada di Tiongkok."]},{"id":93,"hanzi":"今年","pinyin":"jīn nián","meaning":"this year","idn":["Tahun ini saya umur dua puluh.","Tahun ini saya sibuk.","Tahun ini kamu umur berapa?","Tahun ini kami pergi ke Tiongkok.","Musim dingin tahun ini dingin.","Tahun ini dia mulai belajar Mandarin.","Tahun ini saya tidak pulang merayakan tahun baru.","Tahun ini saya mau belajar nyetir.","Tahun ini anak laki-lakinya masuk SD.","Tahun ini pekerjaan kami banyak."]},{"id":94,"hanzi":"今天","pinyin":"jīn tiān","meaning":"today","idn":["Hari ini saya sibuk.","Hari ini tanggal berapa?","Cuaca hari ini bagus.","Hari ini kamu mau ke mana?","Hari ini hari Senin.","Dia hari ini tidak masuk kerja.","Hari ini kita makan pangsit.","Pagi ini kamu makan apa?","Hari ini saya yang masak.","Hari ini ulang tahunku."]},{"id":95,"hanzi":"九","pinyin":"jiǔ","meaning":"nine","idn":["Sekarang jam sembilan.","Dia sudah umur sembilan tahun.","Cuaca bulan September bagus.","Saya punya sembilan apel.","Sembilan puluh sembilan yuan.","Kami berangkat tanggal sembilan.","Sampai jumpa jam sembilan pagi.","Dia masuk kerja jam sembilan.","Segelas sembilan yuan.","Keluargaku ada sembilan orang."]},{"id":96,"hanzi":"觉得","pinyin":"jué de","meaning":"to think; feel","idn":["Menurutku enak.","Menurutmu gimana?","Kurasa dia tidak jadi datang.","Dia merasa Mandarin susah.","Kurasa hari ini akan hujan.","Menurutmu ini bagus nggak?","Menurutku agak mahal.","Kamu tidak merasa begitu?","Menurutku dia orang baik.","Menurutku di sini tidak seru."]},{"id":97,"hanzi":"开","pinyin":"kāi","meaning":"to switch on; open","idn":["Tolong bukakan pintu.","Tokonya buka jam berapa?","Dia membuka sebuah perusahaan.","Rapatnya mulai, cepat.","Pintunya terbuka.","Hari ini toko tidak buka.","Tolong bukakan.","Jangan nyalakan TV.","Kereta berangkat jam delapan lewat sepuluh.","Sekolah sudah mulai?"]},{"id":98,"hanzi":"开车","pinyin":"kāi chē","meaning":"to drive a car","idn":["Dia bisa nyetir.","Kamu datang nyetir?","Kalau sudah minum jangan nyetir.","Biar kuantar pakai mobil.","Ayah nyetirnya cepat.","Ke sana pakai mobil butuh satu jam.","Kamu suka nyetir?","Dia sedang belajar nyetir.","Jangan telepon saat nyetir.","Dia nyetir ke kantor."]},{"id":99,"hanzi":"看","pinyin":"kàn","meaning":"to see; to read; to watch; to look at","idn":["Saya mau lihat-lihat.","Kamu lagi lihat apa?","Saya sedang membaca.","Ayo kita nonton film.","Dia sedang nonton TV.","Kamu pernah nonton film ini?","Coba biar kulihat.","Lihat! Itu apa?","Besok saya mau menjenguknya.","Buku ini sudah selesai kubaca."]},{"id":100,"hanzi":"看病","pinyin":"kàn bìng","meaning":"to visit a doctor","idn":["Saya pergi ke rumah sakit untuk berobat.","Dia hari ini pergi ke dokter.","Kamu mau periksa ke dokter?","Mama mengantar anak ke dokter.","Berobat mahal nggak?","Dia sakit, pergi ke dokter.","Besok saya menemaninya ke dokter.","Kamu berobat di mana?","Berobat harus menunggu lama.","Orang yang berobat di rumah sakit ini banyak."]}]
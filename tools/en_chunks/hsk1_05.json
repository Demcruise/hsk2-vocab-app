[{"id":101,"hanzi":"看见","pinyin":"kàn jiàn","meaning":"see","idn":["Saya melihat seekor kucing.","Apakah kamu melihat HP-ku?","Dia tidak melihat guru.","Saya melihatnya di sekolah.","Kamu melihat orang itu?","Kemarin aku melihatnya.","Dia melihat temannya di stasiun.","Aku tidak melihatnya.","Di mana kamu melihatnya?","Adikku melihat seekor anak anjing, dia sangat senang."]},{"id":102,"hanzi":"可以","pinyin":"kě yǐ","meaning":"can; may","idn":["Bolehkah saya masuk?","Kamu bisa datang besok.","Bisa lebih murah sedikit?","Boleh saya minum air?","Kamu tidak boleh pergi.","Boleh saya duduk di sini?","Air ini bisa diminum?","Boleh saya coba?","Kamu boleh meneleponku.","Guru bilang aku boleh pulang."]},{"id":103,"hanzi":"课","pinyin":"kè","meaning":"lesson","idn":["Kami ada pelajaran hari ini.","Jam berapa pelajaranmu?","Pelajaran hari ini bagus.","Hari ini aku ada empat pelajaran.","Kemarin dia tidak datang ke kelas.","Pelajaran selesai, ayo pulang.","Kamu ada kelas malam ini?","Besok aku tidak ada kelas.","Apakah pelajaran ini sulit?","Guru sedang mengajar."]},{"id":104,"hanzi":"口","pinyin":"kǒu","meaning":"mouth; [measure word for family members]","idn":["Ada berapa anggota keluargamu?","Keluarga kami ada empat orang.","Minumlah seteguk air.","Dia makan sesuap nasi.","Aku menunggumu di depan pintu.","Aku haus.","Keluargaku ada lima orang.","Dia makan dengan lahap.","Di depan pintu ada seekor kucing.","Aku mau makan sepotong roti lagi."]},{"id":105,"hanzi":"块","pinyin":"kuài","meaning":"lump; piece","idn":["Roti ini berapa harganya?","Ini sepuluh yuan.","Aku punya sebuah jam tangan.","Hanya lima yuan.","Potongan ini milikku.","Beri aku satu yuan.","Potongan apel ini untukmu.","Hari ini dia membawa dua puluh yuan.","Baju itu tiga ratus yuan.","Di atas meja ada sepotong roti."]},{"id":106,"hanzi":"来","pinyin":"lái","meaning":"to come","idn":["Dia datang ke rumahku.","Kamu datang besok?","Ibuku hari ini datang ke Beijing.","Cepat kemari!","Besok aku tidak bisa datang.","Kapan mereka datang?","Aku datang bulan lalu.","Apakah dokter sudah datang?","Semua orang sudah datang.","Tahun depan aku ingin datang ke Tiongkok."]},{"id":107,"hanzi":"老师","pinyin":"lǎo shī","meaning":"teacher","idn":["Dia adalah guruku.","Halo, Pak/Bu Guru!","Guru kami sangat sibuk.","Siapa nama gurumu?","Guru hari ini tidak datang.","Aku ingin menjadi guru.","Guru ada di dalam kelas.","Kami semua sangat suka guru ini.","Guru memberiku secangkir teh.","Gurumu orang dari negara mana?"]},{"id":108,"hanzi":"了","pinyin":"le","meaning":"[makes an exclamation]","idn":["Aku sudah makan.","Hujan turun.","Kemarin aku membeli sebuah HP.","Dia sudah pergi.","Bagus sekali!","Aku minum dua gelas air.","Ibu meneleponku.","Kami sudah sampai di rumah.","Dia sudah datang.","Hari ini dingin sekali."]},{"id":109,"hanzi":"冷","pinyin":"lěng","meaning":"cold","idn":["Hari ini sangat dingin.","Aku tidak takut dingin.","Di luar sangat dingin.","Air ini terlalu dingin, tidak bisa diminum.","Kamu kedinginan?","Hari ini lebih dingin daripada kemarin.","Saat dingin aku suka minum teh panas.","Di rumah sakit agak dingin.","Besok akan dingin?","Aku merasa sangat kedinginan."]},{"id":110,"hanzi":"里","pinyin":"lǐ","meaning":"in","idn":["Aku di dalam kelas.","Apa yang ada di dalam buku?","Dia tinggal di lingkungan sekolah.","Kucing ada di dalam rumah.","Di dalam gelas ada air.","Di rumahku tidak ada orang.","Buku ada di dalam tas.","Dia bekerja di rumah sakit.","Di dalam toko ada banyak orang.","Siapa di dalam kamar?"]},{"id":111,"hanzi":"两","pinyin":"liǎng","meaning":"two (of something)","idn":["Aku punya dua buku.","Dia membeli dua apel.","Kami berdua pergi bersama.","Sampai jumpa jam dua!","Aku minum dua cangkir teh.","Dia punya dua anak perempuan.","Kedua baju ini sama-sama cantik.","Aku menunggu selama dua jam.","Di rumahnya ada dua ekor anjing.","Sudah jam setengah tiga, ayo cepat."]},{"id":112,"hanzi":"零","pinyin":"líng","meaning":"zero","idn":["Sekarang jam dua belas lebih lima menit.","Aku tinggal di kamar nomor 309.","Hari ini nol derajat.","Total seratus lima yuan.","Kelas mulai jam sembilan lebih lima.","Baju itu dua ratus satu yuan.","Nomor kamarnya 205.","Tahun ini tahun 2025.","Sudah jam sepuluh lebih empat menit.","Baju ini tiga ratus enam yuan."]},{"id":113,"hanzi":"六","pinyin":"liù","meaning":"six","idn":["Sekarang jam enam.","Aku punya enam teman.","Dia bangun jam enam.","Bulan Juni sangat panas.","Aku pulang jam enam.","Dia tahun ini berumur enam tahun.","Aku membeli enam bakpao.","Sampai jumpa hari Sabtu.","Tanggal enam adalah ulang tahunku.","Sudah jam setengah tujuh, ayo berangkat."]},{"id":114,"hanzi":"妈妈","pinyin":"mā ma","meaning":"mother","idn":["Ibuku adalah guru.","Ibu sedang memasak.","Aku rindu ibu.","Ulang tahun ibu adalah besok.","Ibu membelikanku baju baru.","Ibumu bekerja di mana?","Aku dan ibu pergi ke toko.","Masakan ibu sangat enak.","Ibu tidak ada di rumah.","Aku menelepon ibu."]},{"id":115,"hanzi":"吗","pinyin":"ma","meaning":"[makes a yes; no question]","idn":["Apa kabar?","Apakah kamu pelajar?","Apakah dia datang besok?","Apakah ini milikmu?","Kamu sudah makan malam?","Pernahkah kamu pergi ke Tiongkok?","Boleh?","Bisakah kamu berbahasa Mandarin?","Apakah ibu ada di rumah?","Kamu suka kucing?"]},{"id":116,"hanzi":"买","pinyin":"mǎi","meaning":"buy","idn":["Aku ingin membeli sebuah baju.","Dia belanja di toko.","Berapa harga buku ini? Aku mau beli.","Ibu membeli beberapa buah.","Dia membeli HP baru.","Kamu beli apa hari ini?","Aku tidak mau beli yang itu.","Besok aku akan pergi belanja sayur.","Siapa yang membeli ini?","Kemarin dia membeli seekor kucing."]},{"id":117,"hanzi":"卖","pinyin":"mài","meaning":"to sell","idn":["Toko ini menjual buah-buahan.","Apakah mereka menjual HP?","Toko itu tidak menjual buku.","Di sini menjual apa?","Dia menjual mobil.","Rumah ini mau dijual?","Toko itu menjual baju.","Ibuku menjual sayur di pasar.","Ini dijual berapa?","Barang yang dia jual sangat bagus."]},{"id":118,"hanzi":"忙","pinyin":"máng","meaning":"busy","idn":["Aku hari ini sangat sibuk.","Kamu sibuk?","Dia beberapa hari ini sangat sibuk.","Ayah sibuk bekerja.","Telepon aku saat tidak sibuk.","Kamu sedang sibuk apa?","Akhir pekan kami tidak sibuk.","Hari ini toko sangat ramai.","Besok aku tidak sibuk, kita bisa bertemu.","Ibu setiap hari sangat sibuk."]},{"id":119,"hanzi":"猫","pinyin":"māo","meaning":"cat","idn":["Di rumahku ada seekor kucing.","Kucing sedang tidur.","Kamu suka kucing atau anjing?","Kucing ini sangat lucu.","Kucing suka makan ikan.","Kucing itu milik siapa?","Aku melihat seekor kucing hitam.","Kucing adikku sakit.","Kucing ada di bawah meja.","Kucingmu namanya apa?"]},{"id":120,"hanzi":"没关系","pinyin":"méi guān xi","meaning":"no problem","idn":["Maaf. —Tidak apa-apa.","Tidak apa-apa, aku tidak buru-buru.","Terlambat sedikit tidak apa-apa.","Tidak apa-apa, kita bertemu lagi lain kali.","Dia bilang tidak apa-apa.","Tidak apa-apa, aku bisa sendiri.","Datang terlambat tidak apa-apa?","Dia lupa ulang tahunku, tidak apa-apa.","Tidak masalah, aku masih punya uang.","Tidak apa-apa, besok datang lagi saja."]},{"id":121,"hanzi":"没事","pinyin":"méi shì","meaning":"it's nothing; it doesn't matter; no problem","idn":["Aku tidak apa-apa, terima kasih.","Kamu tidak apa-apa kan?","Hari ini tidak ada urusan, ayo kita nonton film.","Dia tidak apa-apa, hanya agak lelah.","Kalau tidak ada urusan, telepon aku.","Jangan khawatir, tidak apa-apa kok.","Sore ini kamu tidak ada urusan kan? Ayo pergi bersama.","Sekarang dia sudah tidak apa-apa.","Besok aku tidak ada urusan, bisa datang.","Dia bilang tidak apa-apa."]},{"id":122,"hanzi":"没有","pinyin":"méi yǒu","meaning":"don't have","idn":["Aku tidak punya uang.","Dia tidak pergi.","Hari ini tidak ada kelas.","Aku tidak punya waktu.","Kamu sudah makan? —Belum.","Aku tidak melihatnya.","Di rumah airnya sudah habis.","Dia hari ini tidak datang ke kelas.","Aku tidak punya adik perempuan.","Kemarin tidak hujan."]},{"id":123,"hanzi":"妹妹","pinyin":"mèi mei","meaning":"younger sister","idn":["Aku punya seorang adik perempuan.","Adikku tahun ini berumur lima tahun.","Adikku sedang belajar bahasa Mandarin.","Adikku tiga tahun lebih muda dariku.","Adikku suka kucing.","Adikmu namanya siapa?","Adikku kemarin sakit.","Aku dan adikku pergi ke sekolah.","Adikku di rumah menonton TV.","Adikku adalah dokter."]},{"id":124,"hanzi":"们","pinyin":"men","meaning":"plural suffix for pronouns and nouns referring to","idn":["Ayo kita pergi.","Mereka datang besok.","Kalian jam berapa pergi?","Halo teman-teman sekelas!","Para guru semuanya sudah datang.","Kita bertemu besok.","Mereka sedang makan.","Teman-teman, halo!","Kami semua suka belajar bahasa Mandarin.","Anak-anak ada di rumah."]},{"id":125,"hanzi":"米饭","pinyin":"mǐ fàn","meaning":"rice [cooked; boiled]","idn":["Aku suka makan nasi.","Kamu mau nasi atau mi?","Nasi ada di atas meja.","Dia setiap hari makan nasi.","Nasi ini enak.","Aku tidak makan nasi.","Ibu sedang memasak nasi.","Beri aku semangkuk nasi.","Kamu makan berapa mangkuk nasi?","Nasi sudah agak dingin."]}]
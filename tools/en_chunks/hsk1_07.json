[{"id":151,"hanzi":"牛奶","pinyin":"niú nǎi","meaning":"milk","idn":["Aku minum susu setiap pagi.","Kamu mau minum susu atau teh?","Susu segelas ini kepanasan.","Aku tidak suka minum susu.","Mama beli tiga kotak susu.","Susunya di mana?","Anak laki-lakiku suka banget minum susu.","Susu di toko ini murah banget.","Dia habis minum susu langsung tidur.","Permisi, ada susu?"]},{"id":152,"hanzi":"女","pinyin":"nǚ","meaning":"female","idn":["Dia perempuan, bukan laki-laki.","Perempuan itu guruku.","Kamu laki-laki atau perempuan?","Di kelas kami ada sepuluh siswi.","Dokter perempuan itu baik sekali.","Sopir perempuan itu nyetirnya pelan.","Ada tiga perempuan yang kerja di toko itu.","Kamu kenal ibu ini?","Dia bukan perempuan, dia papaku.","Siswi-siswi semuanya suka nyanyi."]},{"id":153,"hanzi":"女儿","pinyin":"nǚ ér","meaning":"daughter","idn":["Putriku tahun ini umur lima tahun.","Putrinya belajar di sekolah.","Siapa nama putrimu?","Putrinya cantik sekali.","Putriku suka makan buah.","Dia punya tiga putri.","Putrimu sudah sekolah?","Putriku kemarin sakit.","Gadis ini putriku.","Putrinya telepon mamanya."]},{"id":154,"hanzi":"女朋友","pinyin":"nǚ péng you","meaning":"girlfriend","idn":["Ini pacarku.","Kamu punya pacar?","Pacarnya orang Tiongkok.","Pacarku suka nonton film.","Dia pergi makan sama pacarnya.","Aku nggak punya pacar.","Pacarmu sekolah di mana?","Besok ulang tahun pacarku.","Pacarnya cantik dan baik.","Aku mau belikan pacarku baju."]},{"id":155,"hanzi":"女士","pinyin":"nǚ shì","meaning":"lady; Madam; Miss","idn":["Ibu ini guruku.","Ibu itu mau minum secangkir teh.","Bu, permisi, di sini ada toko buku?","Ibu itu beli banyak buah.","Ibu Wang kerja di rumah sakit.","Ibu ini bisa bahasa Mandarin?","Tiga wanita jalan di depan.","Ibu Li temannya mamaku.","Bu, ponsel Anda di sini.","Ibu itu tidak minum kopi."]},{"id":156,"hanzi":"朋友","pinyin":"péng you","meaning":"friend","idn":["Dia teman baikku.","Kamu punya berapa teman Tiongkok?","Aku pergi nonton bareng temanku.","Teman ini dokter.","Kawan, sudah makan belum?","Teman-temanku semuanya suka nyanyi.","Besok temanku mau datang ke rumahku.","Dia temanku di sekolah.","Kamu sudah telepon temanmu?","Temanku lagi belanja di toko."]},{"id":157,"hanzi":"便宜","pinyin":"pián yi","meaning":"cheap","idn":["Barang ini murah banget.","Buah di toko mana yang paling murah?","Baju ini nggak murah.","Murah banget, aku beli dua.","Susu di toko itu murah.","Apel ini murah nggak?","Murah dan enak.","Buku di sini murah.","Dimurahin sedikit dong!","Menurutmu ini mahal atau murah?"]},{"id":158,"hanzi":"漂亮","pinyin":"piào liang","meaning":"beautiful","idn":["Dia cantik banget.","Gadis ini cantik banget!","Bajumu bagus sekali.","Tempat itu indah nggak?","Pacarku cantik dan baik.","Toko ini bagus banget.","Dia cantik pakai baju ini.","Nggak cantik, aku nggak suka.","Putrimu cantik banget!","Ponsel ini bagus dan murah."]},{"id":159,"hanzi":"苹果","pinyin":"píng guǒ","meaning":"apple","idn":["Aku mau makan satu apel.","Apel ini berapa harganya?","Apel ini enak.","Mama beli lima apel.","Kamu suka makan apel?","Aku nggak makan apel.","Di atas meja ada tiga apel.","Dia lagi makan apel.","Apel di sini murah dan bagus.","Kasih aku satu apel, makasih."]},{"id":160,"hanzi":"七","pinyin":"qī","meaning":"seven","idn":["Satu minggu ada tujuh hari.","Aku punya tujuh teman.","Dia bangun jam tujuh.","Tujuh tambah tiga sama dengan sepuluh.","Hari ini tanggal 7 Juli.","Ini berapa? Tujuh yuan.","Adikku umur tujuh tahun.","Bulan Juli cuacanya panas.","Kita ketemu jam tujuh.","Tujuh orang itu semuanya ada di sekolah."]},{"id":161,"hanzi":"起床","pinyin":"qǐ chuáng","meaning":"get up (out of bed)","idn":["Aku tiap pagi bangun jam enam.","Kamu bangun jam berapa?","Dia belum bangun.","Cepat bangun! Udah mau sekolah nih.","Kemarin aku baru bangun jam delapan.","Habis bangun aku minum air.","Aku nggak mau bangun, capek banget.","Hari Minggu kamu bangun jam berapa?","Dia habis bangun langsung lari.","Mama bangunin aku."]},{"id":162,"hanzi":"千","pinyin":"qiān","meaning":"thousand","idn":["Barang ini harganya tiga ribu yuan.","HP ini dua ribu yuan.","Sekolah kami ada seribu murid.","Seribu yuan kemahalan.","Dia punya ribuan buku.","Ini berapa? Seribu lima ratus.","Komputer ini lima ribu yuan.","Dua ribu murid belajar di sana.","Baju ini seribu yuan, kemahalan.","Dia punya delapan ribu yuan nggak?"]},{"id":163,"hanzi":"前","pinyin":"qián","meaning":"front, forward, ahead, before","idn":["Di depan sekolah ada toko.","Aku ada di depanmu.","Tiga hari lalu aku pergi ke Beijing.","Dia jalan di depan.","Sebelum kelas aku lagi baca buku.","Orang di depan itu siapa?","Di depan rumahku ada rumah sakit.","Dua minggu lalu dia datang.","Kamu lihat ke depan.","Sebelum jam sembilan aku di rumah."]},{"id":164,"hanzi":"钱","pinyin":"qián","meaning":"money","idn":["Ini berapa harganya?","Aku nggak punya uang.","Dia punya banyak uang.","Kamu punya uang?","Beli buku butuh seratus yuan.","Uangku di mana?","Apel tiga yuan satu buah.","Dia kasih aku sepuluh yuan.","Aku nggak ada uang buat beli itu.","Uangnya di atas meja."]},{"id":165,"hanzi":"请","pinyin":"qǐng","meaning":"to invite; please","idn":["Silakan duduk.","Tolong kasih aku segelas air.","Aku traktir kamu makan.","Tolong diulang sekali lagi.","Besok aku traktir kamu nonton.","Tolong bukakan pintu.","Dia mau traktir aku minum teh.","Silakan tulis namamu.","Silakan masuk.","Guru traktir kami makan."]},{"id":166,"hanzi":"请问","pinyin":"qǐng wèn","meaning":"Excuse me, may I ask...?","idn":["Permisi, siapa namamu?","Permisi, toko buku di mana?","Permisi, sekarang jam berapa?","Permisi, ini berapa harganya?","Permisi, Anda guru?","Permisi, ada rumah sakit di sini?","Permisi, toilet di mana?","Permisi, Anda bisa bahasa Mandarin?","Permisi, ke stasiun kereta lewat mana?","Permisi, Anda dari negara mana?"]},{"id":167,"hanzi":"去","pinyin":"qù","meaning":"to go","idn":["Aku mau pergi ke Beijing.","Kamu mau ke mana?","Besok kami pergi ke sekolah.","Dia nggak pergi ke toko.","Aku ke rumah sakit jenguk teman.","Kemarin kami pergi makan.","Kapan kamu pergi ke Tiongkok?","Ayo kita pergi bareng.","Dia udah berangkat kerja.","Sabtu ini aku mau pergi liburan."]},{"id":168,"hanzi":"去年","pinyin":"qù nián","meaning":"last year","idn":["Tahun lalu aku pergi ke Tiongkok.","Tahun lalu dia belajar di Beijing.","Aku beli HP ini tahun lalu.","Musim panas tahun lalu panas banget.","Tahun lalu kamu kerja di mana?","Dia datang tahun lalu.","Tahun lalu kami pergi ke tiga tempat.","Tahun lalu apel murah.","Tahun lalu dia baru umur dua puluh.","Tahun lalu aku belum kenal dia."]},{"id":169,"hanzi":"热","pinyin":"rè","meaning":"hot","idn":["Hari ini panas banget.","Air segelas ini kepanasan.","Musim panas di Beijing panas banget.","Kamu kepanasan? Mau minum air?","Mienya masih panas, makan pelan-pelan.","Di luar panas nggak?","Kemarin nggak terlalu panas.","Kalau panas aku suka minum air.","Di rumah panas banget.","Dia kepanasan sampai nggak mau makan."]},{"id":170,"hanzi":"人","pinyin":"rén","meaning":"person; people","idn":["Orang itu temanku.","Di sini ada berapa orang?","Dia orang Tiongkok.","Di rumah nggak ada orang.","Orang ini baik banget.","Kamu kenal orang itu?","Di toko banyak orang.","Orang di depan itu siapa?","Kami bertiga.","Orang itu lagi nelpon."]},{"id":171,"hanzi":"认识","pinyin":"rèn shi","meaning":"to know [be familiar with]","idn":["Aku kenal dia.","Kamu kenal orang itu?","Kami nggak saling kenal.","Senang kenal kamu.","Kamu udah kenal dia berapa tahun?","Aku nggak kenal huruf ini.","Dia kenal banyak teman Tiongkok.","Kami kenal di sekolah.","Kamu kenal Guru Wang?","Kemarin aku kenal teman baru."]},{"id":172,"hanzi":"日","pinyin":"rì","meaning":"day [date]; sun","idn":["Hari ini tanggal berapa?","8 Maret ulang tahunnya.","Ulang tahunku tanggal 1 Oktober.","Kami pergi tanggal 15 Agustus.","25 Desember hari apa ya?","Hari ini 1 Januari, tahun baru.","Besok tanggal 2 Mei.","Ulang tahunmu tanggal berapa?","Tanggal 7 Juli kita ketemu.","30 November ulang tahun mamanya."]},{"id":173,"hanzi":"三","pinyin":"sān","meaning":"three","idn":["Aku punya tiga kakak perempuan.","Jam tiga aku di rumah.","Tanggal 3 Maret hari Senin.","Dia makan tiga apel.","Kelas kami ada tiga puluh murid.","Ini tiga yuan, itu lima yuan.","Keluargaku ada tiga orang.","Tanggal tiga dia nggak datang.","Kasih aku tiga gelas air.","Aku jam tiga pergi kelas."]},{"id":174,"hanzi":"商店","pinyin":"shāng diàn","meaning":"shop","idn":["Tokonya di mana?","Toko ini gede banget.","Aku pergi ke toko belanja.","Di toko banyak orang.","Toko itu jual buah.","Toko buka jam delapan.","Di depan ada toko.","Barang di toko ini murah-murah.","Dia kerja di toko.","Toko hari ini tutup."]},{"id":175,"hanzi":"上","pinyin":"shàng","meaning":"up; above; on; previous","idn":["Bukunya di atas meja.","HP-nya di atas kasur.","Minggu lalu dia sakit.","Bulan lalu aku pergi ke Shanghai.","Di atas meja ada apel dan susu.","Dia naik mobil langsung pergi.","Namanya ada di atas.","Pelajaran sebelumnya kelas Mandarin.","Pagi ini aku di rumah.","Dari sini jalan ke atas."]}]
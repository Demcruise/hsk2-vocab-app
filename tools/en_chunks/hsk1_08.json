[{"id":176,"hanzi":"上班","pinyin":"shàng bān","meaning":"start work","idn":["Aku tiap hari masuk kerja jam delapan.","Kamu masuk kerja jam berapa?","Papa hari ini nggak kerja.","Dia udah berangkat kerja.","Hari Minggu aku nggak kerja.","Pas kerja jangan main HP.","Dia kerja di mana?","Kemarin dia berangkat kerja jam enam.","Tempat kerjaku jauh dari sini.","Kerja capek nggak?"]},{"id":177,"hanzi":"上课","pinyin":"shàng kè","meaning":"to go to class","idn":["Kami mulai kelas jam delapan.","Hari ini ada kelas?","Dia lagi kelas, jangan ngomong.","Sore kami pergi kelas.","Kemarin aku nggak masuk kelas.","Ikut kelas itu seru banget.","Kamu kelas pagi atau sore?","Pas kelas nggak boleh nelpon.","Murid-murid lagi kelas.","Sabtu kami nggak ada kelas."]},{"id":178,"hanzi":"上午","pinyin":"shàng wǔ","meaning":"morning","idn":["Pagi ini aku ada kelas.","Pagi tadi dia ke rumah sakit.","Sampai ketemu besok pagi.","Jam sepuluh pagi aku telepon kamu.","Kamu pagi ngapain?","Kemarin pagi hujan.","Pagi ini aku di rumah baca buku.","Pagi cuacanya nggak panas.","Sabtu pagi dia kerja.","Selamat pagi!"]},{"id":179,"hanzi":"上学","pinyin":"shàng xué","meaning":"to go to school","idn":["Tiap hari aku berangkat sekolah jam tujuh.","Anakmu udah sekolah belum?","Anak-anak udah berangkat sekolah.","Dia mulai sekolah umur enam tahun.","Hari ini nggak sekolah, kan Minggu.","Aku sekolah di Beijing.","Adikku tahun ini mulai sekolah.","Kamu berangkat sekolah jam berapa?","Kalau hujan dia nggak pergi sekolah.","Sejak sekolah dia jarang main."]},{"id":180,"hanzi":"少","pinyin":"shǎo","meaning":"few","idn":["Orang di sini dikit.","Uangku dikit banget.","Hari ini toko sepi.","Bukunya dikit.","Dikit aja, makasih.","Dia makannya dikit banget.","Murid sekolah ini dikit.","Nggak dikit orang di sana.","Hari ini hujan, yang keluar dikit.","Waktunya dikit banget."]},{"id":181,"hanzi":"谁","pinyin":"shéi/shuí","meaning":"who?","idn":["Kamu siapa?","Orang itu siapa?","Siapa di sana?","Ini buku siapa?","Siapa yang suka makan apel?","Siapa yang nelpon?","Semua orang pengen pulang.","Nggak ada yang kenal dia.","Kamu pergi sama siapa?","HP siapa di sini?"]},{"id":182,"hanzi":"什么","pinyin":"shén me","meaning":"what?","idn":["Ini apa?","Siapa namamu?","Kamu mau makan apa?","Kapan berangkatnya?","Dia lagi ngapain?","Nggak apa-apa.","Kamu beli buah apa?","Hari ini hari apa?","Aku nggak tahu apa-apa.","Ini huruf apa?"]},{"id":183,"hanzi":"生病","pinyin":"shēng bìng","meaning":"ill; sick; unwell","idn":["Aku sakit, nggak bisa masuk kelas.","Dia sakit, tidur di rumah.","Mama sakit.","Kamu sakit?","Pas sakit harus banyak minum air.","Dia nggak sakit, cuma capek.","Siapa yang sakit?","Kemarin adikku sakit.","Orang sakit pergi ke rumah sakit.","Aku jarang sakit."]},{"id":184,"hanzi":"十","pinyin":"shí","meaning":"ten","idn":["Aku punya sepuluh apel.","Sekarang jam 10.15.","1 Oktober hari apa?","Ini sepuluh yuan.","Sepuluh kurang lima sama dengan lima.","Kelas kami ada sepuluh murid.","Adikku umur sepuluh tahun.","Tidur jam sepuluh malam.","Sepuluh orang itu semuanya murid.","Desember ada tiga puluh satu hari."]},{"id":185,"hanzi":"时候","pinyin":"shí hou","meaning":"[duration of] time","idn":["Kapan kamu pergi?","Pas makan jangan ngomong.","Waktu kecil aku tinggal di sana.","Pas kelas nggak boleh main HP.","Kapan kamu ada waktu?","Pas dia pulang hujan turun.","Sekarang waktunya tidur.","Kamu ngapain waktu di Beijing?","Kalau dingin pakai baju lebih banyak.","Kapan nelpon dia?"]},{"id":186,"hanzi":"时间","pinyin":"shí jiān","meaning":"time","idn":["Aku nggak punya waktu.","Kamu punya waktu berapa banyak?","Waktunya udah tiba.","Jam kelasnya jam delapan.","Ada waktu nggak? Kita makan yuk.","Kalau nggak ada waktu ya jangan pergi.","Waktunya dikit banget.","Jam berapa ketemunya?","Kasih aku waktu sedikit.","Waktu belajar nggak boleh kurang."]},{"id":187,"hanzi":"事","pinyin":"shì","meaning":"matter, affair, thing","idn":["Hari ini aku ada urusan.","Ada apa?","Santai, nggak apa-apa.","Dia udah tahu soal ini.","Urusan lain besok dibahas lagi.","Ini urusanku.","Kalau ada urusan, telepon aku.","Hal itu nggak baik.","Apa yang bikin kamu segirang ini?","Dia lagi ada kerjaan, jangan ngomong."]},{"id":188,"hanzi":"是","pinyin":"shì","meaning":"to be","idn":["Aku murid.","Dia guruku.","Ini apel?","Hari ini bukan hari Minggu.","Kamu orang mana?","Itu bukuku.","Bener dia?","Kami berteman.","Siapa Guru Wang?","Baju ini punyamu."]},{"id":189,"hanzi":"手机","pinyin":"shǒu jī","meaning":"mobile phone","idn":["HP-ku di mana?","Ini HP baruku.","Kamu punya HP?","Dia lagi main HP.","HP ini berapa?","Jangan melulu lihat HP.","HP-nya habis baterai.","Aku nelpon pakai HP.","HP siapa di atas meja?","Di HP-ku nggak ada namanya."]},{"id":190,"hanzi":"书","pinyin":"shū","meaning":"book","idn":["Ini bukuku.","Kamu lagi baca buku apa?","Buku ini berapa?","Dia punya banyak buku.","Aku suka baca buku Mandarin.","Bukunya di atas meja.","Buku siapa di sini?","Buku ini bagus banget.","Aku beli satu buku.","Jangan baca buku di kendaraan."]},{"id":191,"hanzi":"书店","pinyin":"shū diàn","meaning":"bookstore","idn":["Toko bukunya di mana?","Di depan ada toko buku.","Aku ke toko buku beli buku.","Toko buku ini gede.","Di toko buku banyak orang.","Toko buku buka jam berapa?","Dia kerja di toko buku.","Buku di toko buku itu murah.","Ada toko buku di sebelah sekolah?","Kemarin aku pergi ke toko buku."]},{"id":192,"hanzi":"水","pinyin":"shuǐ","meaning":"water","idn":["Aku mau minum air.","Kasih aku segelas air.","Airnya kepanasan, nggak bisa diminum.","Kamu minum air atau teh?","Di sini nggak ada air.","Kalau sakit harus banyak minum air.","Ada air di atas meja?","Dia tiap hari minum banyak air.","Airnya di mana?","Satu botol air tiga yuan."]},{"id":193,"hanzi":"水果","pinyin":"shuǐ guǒ","meaning":"fruit","idn":["Aku suka makan buah.","Buah di sini murah.","Mama beli banyak buah.","Kamu beli buah apa?","Apel itu buah.","Makan buah tiap hari itu bagus.","Di toko ada buah.","Dia nggak suka makan buah.","Buahnya berapa sekilo?","Malam makan buah dikit yuk."]},{"id":194,"hanzi":"睡","pinyin":"shuì","meaning":"to sleep","idn":["Aku mau tidur nih.","Dia masih tidur.","Kamu udah tidur?","Udah kemaleman, cepat tidur.","Dia tidur di kursi.","Kemarin aku tidur jam sepuluh.","Jangan tidur lagi, bangun yuk.","Anak udah tidur, jangan ngomong.","Kamu tidur di mana?","Habis kenyang langsung mau tidur."]},{"id":195,"hanzi":"睡觉","pinyin":"shuì jiào","meaning":"to go to bed; to sleep","idn":["Aku mau tidur.","Kamu tidur jam berapa?","Dia lagi tidur, jangan ngomong.","Aku tidur jam sepuluh malam.","Kemarin aku baru tidur jam sepuluh.","Habis makan langsung pengen tidur.","Akhir pekan aku suka tidur di rumah.","Cepat tidur! Besok harus sekolah.","Kamu udah tidur?","Sebelum tidur aku minum susu."]},{"id":196,"hanzi":"说","pinyin":"shuō","meaning":"speak","idn":["Kamu bilang apa?","Tolong diulang sekali lagi.","Dia bisa bahasa Mandarin.","Udah, jangan ngomong lagi!","Yang kubilang bener.","Kamu bener.","Dia bilang besok datang.","Aku ngomong Mandarin, kamu ngomong Inggris.","Dengerin aku dulu.","Ini gimana ngomongnya?"]},{"id":197,"hanzi":"说话","pinyin":"shuō huà","meaning":"speak","idn":["Jangan ngomong, guru lagi ngajar.","Dia lagi ngomong sama pacarnya.","Pas kelas nggak boleh ngomong.","Siapa yang ngomong di sana?","Pas kamu ngomong, tolong pelanin dikit.","Anak udah tidur, jangan ngomong.","Aku suka ngobrol sama kamu.","Mereka ngomongnya kecepatan.","Pas makan dikit ngomongnya.","Dia lagi ngomong sama siapa?"]},{"id":198,"hanzi":"四","pinyin":"sì","meaning":"four","idn":["Aku punya empat apel.","4 April ulang tahunnya.","Sekarang jam 4.10.","Keluargaku ada empat orang.","Baju ini empat puluh yuan.","Kita berempat pergi bareng.","Kamis aku ada kelas.","Dia tidur dari jam empat sampai jam enam.","Empat tambah enam sama dengan sepuluh.","Kasih aku empat gelas air."]},{"id":199,"hanzi":"岁","pinyin":"suì","meaning":"year (of crop harvests)","idn":["Tahun ini kamu umur berapa?","Anakku udah lima tahun.","Dia tahun ini umur dua puluh.","Putrimu umur berapa?","Adikku tiga tahun lebih muda dariku.","Anak ini baru enam tahun.","Kakek udah tujuh puluh tahun.","Kamu umur berapa? Aku delapan belas.","Dia ke Tiongkok waktu umur sepuluh.","Adikku tahun ini udah empat tahun."]},{"id":200,"hanzi":"他","pinyin":"tā","meaning":"he; him","idn":["Dia temanku.","Dia di mana?","Dia nggak jadi datang.","Aku udah nelpon dia.","Dia suka minum susu.","Kamu kenal dia?","Besok dia ke Beijing.","Jangan kasih tahu dia.","Dia lagi makan.","Ini bukuku, bukan punyanya."]}]
[{"id":126,"hanzi":"面包","pinyin":"miàn bāo","meaning":"bread","idn":["Aku makan roti di pagi hari.","Roti ini berapa harganya?","Ibu membeli beberapa roti.","Sarapanku makan roti dan minum susu.","Apakah roti ini dibuat hari ini?","Dia suka makan roti.","Toko itu menjual roti.","Aku ingin makan sedikit roti.","Di atas meja ada sebuah roti.","Potongan roti ini untukmu."]},{"id":127,"hanzi":"面条儿","pinyin":"miàn tiáor","meaning":"noodles","idn":["Hari ini kami makan mi.","Mi di tempat ini sangat enak.","Bisakah kamu membuat mi?","Semangkuk mi sepuluh yuan.","Aku suka makan mi.","Dia memesan semangkuk mi.","Mi-nya panas.","Ibu membuat mi.","Pernahkah kamu makan mi ini?","Siang ini aku ingin makan mi."]},{"id":128,"hanzi":"明年","pinyin":"míng nián","meaning":"next year","idn":["Aku pergi ke Tiongkok tahun depan.","Tahun depan dia berumur sepuluh tahun.","Kita bertemu tahun depan!","Tahun depan aku ingin belajar bahasa Mandarin.","Ayah akan datang tahun depan.","Juni tahun depan dia pergi ke Beijing.","Tahun depan kamu masih di sini?","Tahun depan kami membeli rumah.","Tahun ini sibuk, tahun depan tidak.","Tahun depan kamu akan kembali?"]},{"id":129,"hanzi":"明天","pinyin":"míng tiān","meaning":"tomorrow","idn":["Sampai besok!","Kamu besok ada waktu?","Besok aku pergi ke sekolah.","Besok akan hujan?","Besok kita makan bersama.","Besok adalah ulang tahun ibu.","Dia besok jadi tidak datang.","Bagaimana cuaca besok?","Besok pagi ada kelas.","Besok aku sangat sibuk."]},{"id":130,"hanzi":"名字","pinyin":"míng zi","meaning":"given name","idn":["Namamu siapa?","Namaku Li Ming.","Nama ini bagus.","Tolong tulis namamu.","Aku lupa namanya.","Nama kucingnya Xiao Bai.","Bagaimana cara menulis namamu?","Apakah dia bernama ini?","Tolong beri tahu aku namamu.","Aku tidak tahu nama guru."]},{"id":131,"hanzi":"哪","pinyin":"nǎ","meaning":"which?","idn":["Kamu orang negara mana?","Hari apa kamu ada waktu?","Dia suka buku yang mana?","Kamu mau pergi ke tempat mana?","Sebelah mana utara?","Dia di ruang kelas mana?","Bulan apa ulang tahunmu?","Yang mana saja boleh.","Kamu datang hari apa?","Yang mana rumahmu?"]},{"id":132,"hanzi":"哪个","pinyin":"nǎ ge","meaning":"which; which one","idn":["Kamu mau yang mana?","Yang mana milikmu?","Yang mana yang enak?","Kamu beli yang mana?","Dia pelajar sekolah mana?","Toko mana yang menjual buah?","Ini guru yang mana?","Yang mana adikmu?","Gelas mana milikmu?","Restoran mana yang enak?"]},{"id":133,"hanzi":"哪里","pinyin":"nǎ lǐ","meaning":"where?","idn":["Kamu di mana?","Kamu tinggal di mana?","Stasiun di mana?","Kamu bekerja di mana?","Kamu beli ini di mana?","Dia pergi ke mana?","Sekolah ada di mana?","HP-ku di mana?","Kamu belajar bahasa Mandarin di mana?","Kalian bertemu di mana?"]},{"id":134,"hanzi":"哪儿","pinyin":"nǎ ér","meaning":"where?","idn":["Kamu mau ke mana?","Kamu di mana?","Di mana ada restoran?","Dia dari mana?","Adikmu ke mana?","Di mana ada rumah sakit?","Besok kita ke mana?","Teh di mana yang enak?","Kucing di mana?","Kamu beli di mana?"]},{"id":135,"hanzi":"哪些","pinyin":"nǎ xiē","meaning":"which ones?","idn":["Yang mana saja bukumu?","Kamu mau beli barang apa saja?","Orang-orang mana saja yang datang besok?","Baju-baju mana saja milikmu?","Karakter apa saja yang sudah kamu pelajari?","Buah-buah apa saja yang enak?","Murid-murid mana saja yang ada di kelas?","Masakan mana saja yang enak?","Hari-hari apa saja kamu ada waktu?","Toko-toko mana saja yang menjual HP?"]},{"id":136,"hanzi":"那","pinyin":"nà","meaning":"that; those","idn":["Itu bukuku.","Orang itu siapa?","Restoran itu sangat enak.","Kalau begitu, kamu datang besok?","Kalau begitu aku pergi dulu.","Apa itu?","Hari itu aku tidak pergi ke sekolah.","Itu gelas siapa?","Itu mahal kan?","Buku itu sudah pernah aku baca."]},{"id":137,"hanzi":"那边","pinyin":"nà biān","meaning":"over there","idn":["Lihat ke sana!","Toko ada di sebelah sana.","Di sana ada seekor kucing.","Silakan duduk di sana.","Rumahnya di sebelah sekolah sana.","Di sana sedang hujan.","Jalan ke arah sana.","Buah-buah di sana sangat murah.","Mobilku ada di sana.","Dia datang dari sana."]},{"id":138,"hanzi":"那个","pinyin":"nà ge","meaning":"that; that one","idn":["Yang itu milikku.","Aku mau yang itu.","Orang itu adalah guru.","Yang itu berapa harganya?","Anak perempuan itu teman sekelasku.","Restoran itu terlalu mahal.","Aku tidak suka yang itu.","Kamu sedang melihat itu?","Gelas itu milik siapa?","HP itu baru."]},{"id":139,"hanzi":"那里","pinyin":"nà lǐ","meaning":"there; that place","idn":["Sekolah ada di sana.","Aku pernah pergi ke sana.","Di sana sangat panas.","Dia tinggal di sana?","Di sana ada bukuku.","Tahun lalu kami bertemu di sana.","Makanan di sana tidak enak.","Jangan pergi ke sana.","Di sana ada banyak orang.","Aku datang dari sana."]},{"id":140,"hanzi":"那儿","pinyin":"nà ér","meaning":"there","idn":["Di sana ada toko.","Kita ketemu di sana.","Di sana dingin?","Aku menunggumu di sana.","Barang-barang di sana mahal.","Dia pergi ke sana.","Di sana ada sebuah restoran.","Di sana tidak jauh.","Itu rumahku.","Bagaimana cuaca di sana?"]},{"id":141,"hanzi":"那些","pinyin":"nà xiē","meaning":"those","idn":["Itu semua bukuku.","Apel-apel itu berapa harganya?","Orang-orang itu siapa?","Baju-baju itu cantik.","Murid-murid itu di sana.","Kucing-kucing itu lucu.","Barang-barang itu jangan dibeli.","Gelas-gelas itu milik siapa?","Rumah-rumah itu mahal.","Masakan-masakan itu enak."]},{"id":142,"hanzi":"男","pinyin":"nán","meaning":"male","idn":["Dia laki-laki.","Laki-laki itu siapa?","Pria itu sedang bekerja.","Di keluargaku ada dua anak laki-laki.","Laki-laki lebih banyak atau perempuan lebih banyak?","Guru laki-laki itu tinggi.","Teman sekelas laki-lakiku di sana.","Anak laki-laki ada di sebelah sana.","Laki-laki itu sedang menelepon.","Anaknya laki-laki."]},{"id":143,"hanzi":"男朋友","pinyin":"nán péng you","meaning":"boyfriend","idn":["Pacarnya orang Tiongkok.","Aku sudah punya pacar.","Pacarmu bekerja di mana?","Dia belum punya pacar.","Pacarku sedang belajar bahasa Mandarin.","Pacarnya datang besok.","Kamu dan pacarmu baik-baik saja?","Pacarku membelikanku sebuah baju.","Apakah ini pacarnya?","Pacarku tiga tahun lebih tua dariku."]},{"id":144,"hanzi":"呢","pinyin":"ne","meaning":"[returns; forwards a question]","idn":["Kalau kamu?","Aku baik-baik saja, kamu bagaimana?","Bukumu mana?","Dia di mana ya?","Kamu sedang ngapain?","HP-ku mana?","Ibu mana?","Aku sedang makan.","Mereka masih tidur.","Kenapa kamu belum datang juga?"]},{"id":145,"hanzi":"能","pinyin":"néng","meaning":"to be able to; can","idn":["Boleh saya masuk?","Besok aku bisa datang.","Bisakah kamu membantuku?","Dia tidak bisa datang.","Boleh saya coba?","Di sini bisa internetan?","Aku bisa melihat ke sana.","Kapan kamu bisa datang?","Hari ini aku jadi tidak bisa pergi.","Dia sakit, tidak bisa datang ke kelas."]},{"id":146,"hanzi":"你","pinyin":"nǐ","meaning":"you","idn":["Halo!","Kamu bernama siapa?","Aku mentraktirmu makan.","Kamu mau ke mana?","Kamu tahun ini berumur berapa?","Kamu sudah makan?","Aku meneleponmu.","Besok datanglah ke rumahku.","Kamu adalah teman baikku.","Kamu bangun jam berapa?"]},{"id":147,"hanzi":"你好","pinyin":"nǐ hǎo","meaning":"hello; hi","idn":["Halo, namaku Li Ming.","Halo, guru.","Halo! Bagaimana hari ini?","Halo, permisi, toko di mana?","Halo, sudah lama tidak bertemu!","Dia bilang \"halo\" pada guru.","Halo, saya mau secangkir teh.","Halo, saya mau beli ini.","Halo, stasiun di mana?","Halo, boleh saya duduk di sini?"]},{"id":148,"hanzi":"你们","pinyin":"nǐ men","meaning":"you (plural)","idn":["Halo kalian!","Kalian mau ke mana?","Apakah kalian pelajar?","Aku mentraktir kalian minum teh.","Kalian mulai kelas jam berapa?","Kalian semua sudah datang?","Kalian sedang ngapain?","Kalian besok ada waktu?","Besok datanglah makan ke rumahku.","Kalian mau makan apa?"]},{"id":149,"hanzi":"年","pinyin":"nián","meaning":"year","idn":["Tahun ini adalah tahun 2025.","Tahun lalu aku pergi ke Tiongkok.","Selamat tahun baru!","Dia tahun ini berumur dua puluh tahun.","Aku sudah belajar bahasa Mandarin setahun.","Satu tahun ada dua belas bulan.","Tahun itu aku di Beijing.","Kamu lahir tahun berapa?","Beberapa tahun ini aku sangat sibuk.","Setiap tahun aku pulang kampung."]},{"id":150,"hanzi":"您","pinyin":"nín","meaning":"you [polite form]","idn":["Halo!","Siapa nama marga Anda?","Silakan duduk.","Anda minum teh?","Apakah Anda guru?","Anda tinggal di mana?","Anda mau beli apa?","Silakan Anda duluan.","Apakah ini milik Anda?","Hati-hati di jalan!"]}]
[{"id":276,"hanzi":"怎么","pinyin":"zěn me","meaning":"how?","idn":["Kamu kenapa?","Bagaimana cara menulis huruf ini?","Bagaimana cara ke bandara?","Bagaimana cara membuat ini?","Kenapa kamu tidak beli?","Bagaimana jalan ke rumah sakit?","Bagaimana kamu tahu?","Kenapa hari ini dingin sekali?","Bagaimana cara membaca ini?","Bagaimana kamu pergi ke sekolah?"]},{"id":277,"hanzi":"怎么样","pinyin":"zěn me yàng","meaning":"how about it","idn":["Bagaimana buku ini?","Bagaimana cuaca hari ini?","Bagaimana gurumu?","Bagaimana tempat ini?","Bagaimana baju ini?","Menurutmu bagaimana masakan Tiongkok?","Bagaimana sekarang?","Kalau saya begini bagaimana?","Bagaimana kesehatanmu?","Bagaimana masakan ini?"]},{"id":278,"hanzi":"找","pinyin":"zhǎo","meaning":"to find; to look for","idn":["Saya sedang mencari HP saya.","Kamu cari siapa?","Saya tidak bisa menemukan buku saya.","Dia datang mencarimu.","Tolong carikan kunci saya.","Dia sedang mencari pekerjaan.","Ayo kita pergi mencarinya.","Kamu sedang cari apa?","Saya sudah menemukannya!","Dia membantu saya mencari buku."]},{"id":279,"hanzi":"这","pinyin":"zhè","meaning":"this","idn":["Apa ini?","Ini buku saya.","Ini ayah saya.","Ini milik siapa?","Ini kursi saya.","Ini tempat yang bagus.","Ini HP miliknya.","Ini sekolah saya.","Apakah ini rumah sakit?","Huruf apa ini?"]},{"id":280,"hanzi":"这边","pinyin":"zhè biān","meaning":"this side","idn":["Silakan duduk di sebelah sini.","Sebelah sini rumah sakit.","Jalan dari sebelah sini.","Kursi sebelah sini milik saya.","Kami tunggu kamu di sebelah sini.","Orang di sebelah sini banyak.","Silakan ke sebelah sini.","Makanan di sebelah sini enak.","Toko ada di sebelah sini.","Dia tinggal di sebelah sini."]},{"id":281,"hanzi":"这个","pinyin":"zhè ge","meaning":"this; this one","idn":["Saya mau yang ini.","Berapa harga ini?","Siapa orang ini?","Ini enak.","Huruf ini besar.","Saya tidak mau yang ini.","Ini milik guru.","Masakan ini tidak pedas.","Lihat ini!","Bulan ini saya sibuk."]},{"id":282,"hanzi":"这里","pinyin":"zhè lǐ","meaning":"here","idn":["Di sini sangat dingin.","Saya tinggal di sini.","Orang di sini sangat ramah.","Kamu suka di sini?","Di sini ada buku saya.","Silakan duduk sebentar di sini.","Di sini tidak boleh parkir.","Barang di sini murah.","Kita makan di sini.","Di sini rumah saya."]},{"id":283,"hanzi":"这儿","pinyin":"zhè ér","meaning":"here","idn":["Silakan duduk di sini.","Di sini rumah saya.","Cuaca di sini sangat bagus.","Dia bekerja di sini.","Di sini ada banyak orang.","Saya tunggu kamu di sini.","Makanan di sini enak.","Jangan duduk di sini.","Apakah dari sini ke rumah sakit jauh?","Saya suka tempat ini."]},{"id":284,"hanzi":"这些","pinyin":"zhè xiē","meaning":"these","idn":["Apa ini semua?","Ini semua buku saya.","Berapa harga baju-baju ini?","Masakan-masakan ini enak.","Siapa orang-orang ini?","Huruf-huruf ini saya tidak kenal.","Ini semua milik dia.","Apel-apel ini sangat merah.","Saya suka bunga-bunga ini.","Barang-barang ini terlalu berat."]},{"id":285,"hanzi":"真","pinyin":"zhēn","meaning":"real; so (+adjective)","idn":["Ini benar-benar enak.","Kamu tinggi sekali!","Hari ini dingin sekali.","Bahasa Mandarinnya benar-benar bagus.","Tempat ini indah sekali.","Kamu benar-benar tidak tahu?","Masakan ini pedas sekali.","Dia cantik sekali.","Cuaca di sini bagus sekali.","Saya benar-benar kangen kamu."]},{"id":286,"hanzi":"正在","pinyin":"zhèng zài","meaning":"currently; in the process of","idn":["Saya sedang makan.","Dia sedang membaca buku.","Mama sedang memasak.","Kami sedang dalam kelas.","Dia sedang menelepon.","Di luar sedang hujan.","Mereka sedang mengobrol.","Saya sedang belajar bahasa Mandarin.","Guru sedang menulis huruf.","Kami sedang menunggunya."]},{"id":287,"hanzi":"只","pinyin":"zhī","meaning":"individual [measure word for small animals]","idn":["Saya punya seekor kucing.","Anjing ini sangat lucu.","Di rumahnya ada dua ekor burung.","Di atas meja ada seekor kucing.","Beberapa ekor anjing itu besar.","Dia memelihara tiga ekor kucing.","Burung ini bisa bernyanyi.","Seekor kucing di atas tempat tidur.","Kucing itu milik saya.","Dia membeli seekor anak anjing."]},{"id":288,"hanzi":"知道","pinyin":"zhī dào","meaning":"know; realise; be aware of","idn":["Saya tahu.","Kamu tahu dia siapa?","Saya tidak tahu huruf ini.","Dia tahu nama saya.","Siapa tahu dia di mana?","Saya sekarang sudah tahu.","Dia tidak tahu hal ini.","Bagaimana kamu bisa tahu?","Kami semua tahu.","Ayah tahu hal ini."]},{"id":289,"hanzi":"中国","pinyin":"Zhōng guó","meaning":"China","idn":["Saya orang Tiongkok.","Tiongkok sangat besar.","Saya ingin pergi ke Tiongkok.","Dia guru dari Tiongkok.","Masakan Tiongkok enak.","Saya bekerja di Tiongkok.","Teh Tiongkok enak diminum.","Kamu pernah ke Tiongkok?","Tiongkok punya banyak orang.","Teman saya di Tiongkok."]},{"id":290,"hanzi":"中文","pinyin":"Zhōng wén","meaning":"Chinese [written language]","idn":["Saya bisa bicara bahasa Mandarin.","Bahasa Mandarinmu bagus.","Saya sedang belajar bahasa Mandarin.","Bahasa Mandarin sulit.","Dia bisa menulis bahasa Mandarin.","Kamu suka bahasa Mandarin?","Buku ini berbahasa Mandarin.","Bahasa Mandarin saya tidak bagus.","Guru mengajar kami bahasa Mandarin.","Dia sudah belajar bahasa Mandarin satu tahun."]},{"id":291,"hanzi":"中午","pinyin":"zhōng wǔ","meaning":"midday","idn":["Selamat siang!","Kita makan siang.","Siang tadi saya tidur.","Dia pulang siang hari.","Matahari siang sangat terik.","Saya makan siang di sekolah.","Siang ini makan apa?","Sekarang jam dua belas siang.","Jangan keluar siang hari.","Dia menelepon saya siang hari."]},{"id":292,"hanzi":"中学","pinyin":"zhōng xué","meaning":"middle school","idn":["Dia belajar di SMP.","SMP saya besar.","Dia guru SMP.","SMP ini sangat terkenal.","Kami kenalan di SMP.","SMP dekat dari rumah.","Dia sudah masuk SMP.","Adik saya di SMP.","Guru-guru SMP ini baik.","Di SMP ada banyak siswa."]},{"id":293,"hanzi":"中学生","pinyin":"zhōng xué shēng","meaning":"middle-school student","idn":["Dia siswa SMP.","Siswa SMP sibuk.","Putri saya siswa SMP.","Siswa SMP belajar dengan rajin.","Di sini ada dua puluh siswa SMP.","Siswa SMP setiap hari bersekolah.","Siswa-siswa SMP ini tinggi.","PR siswa SMP banyak.","Saya kenal siswa SMP itu.","Siswa SMP suka main HP."]},{"id":294,"hanzi":"住","pinyin":"zhù","meaning":"to live; stay (a number of nights)","idn":["Saya tinggal di Beijing.","Kamu tinggal di mana?","Dia tinggal di samping sekolah.","Kami tinggal di sini.","Dia tinggal di dekat rumah sakit.","Saya menginap satu bulan.","Mereka tinggal di sana.","Orang tua saya tinggal di Shanghai.","Dia menginap tiga hari di hotel ini.","Rumah saya di lantai dua."]},{"id":295,"hanzi":"桌子","pinyin":"zhuō zi","meaning":"table","idn":["Di atas meja ada sebuah buku.","Meja ini besar.","Kucing di bawah meja.","Dia duduk di samping meja.","Saya membeli sebuah meja.","Di atas meja ada banyak masakan.","Meja ini baru.","Tolong taruh buku di atas meja.","Di samping meja ada kursi.","Mejanya bersih."]},{"id":296,"hanzi":"字","pinyin":"zì","meaning":"(Chinese) character","idn":["Bagaimana membaca huruf ini?","Saya kenal huruf ini.","Tulisanmu bagus.","Tolong tulis satu huruf.","Huruf-huruf ini terlalu sulit.","Guru sedang menulis huruf.","Apa arti huruf ini?","Saya bisa menulis huruf Tiongkok.","Namanya ada tiga huruf.","Tolong lihat huruf ini."]},{"id":297,"hanzi":"昨天","pinyin":"zuó tiān","meaning":"yesterday","idn":["Kemarin saya pergi nonton film.","Kemarin hujan.","Kemarin saya sibuk.","Kemarin kamu di mana?","Kemarin hari Jumat.","Kemarin dia membeli buku baru.","Kemarin saya pergi ke rumah sakit.","Cuaca kemarin bagus.","Kemarin saya bertemu dia.","Kemarin saya tidak masuk kelas."]},{"id":298,"hanzi":"坐","pinyin":"zuò","meaning":"to sit","idn":["Silakan duduk.","Saya duduk di kursi.","Kita naik bus pergi.","Dia naik pesawat ke Beijing.","Jangan duduk di sini.","Saya setiap hari naik subway kerja.","Dia duduk di depan meja.","Kita naik taksi pulang.","Silakan duduk di sini.","Dia suka naik kapal."]},{"id":299,"hanzi":"做","pinyin":"zuò","meaning":"to do; to be; become (an occupation)","idn":["Kamu sedang ngapain?","Saya sudah masak.","Dia bekerja sebagai guru.","Kita kerjakan PR bersama.","Mama memasak di rumah.","Saya tidak mau mengerjakan ini.","Apa yang dia lakukan?","Hari ini saya tidak mengerjakan PR.","Bagaimana mengerjakan hal ini?","Dia berbisnis di Tiongkok."]},{"id":300,"hanzi":"做饭","pinyin":"zuò fàn","meaning":"to prepare a meal","idn":["Mama sedang memasak.","Saya bisa memasak.","Siapa yang masak?","Dia memasak setiap malam.","Kita memasak bersama.","Ayah masak dengan enak.","Hari ini saya tidak masak.","Dia suka memasak.","Memasak butuh waktu lama.","Saya sedang belajar memasak."]}]
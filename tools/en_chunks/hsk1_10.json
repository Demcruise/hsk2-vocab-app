[{"id":226,"hanzi":"下","pinyin":"xià","meaning":"down; below","idn":["Silakan duduk.","Buku ada di bawah meja.","Kita turun dari kendaraan yuk.","Di bawah ada orang menunggumu.","Minggu depan saya pergi ke Shanghai.","Di luar hujan.","Sampai jumpa sore nanti!","Kami sudah selesai pelajaran.","Tolong tuliskan.","Dia turun ke lantai bawah."]},{"id":227,"hanzi":"下雨","pinyin":"xià yǔ","meaning":"rain","idn":["Di luar hujan.","Hari ini mau hujan?","Kemarin hujan.","Hujan turun, jangan keluar.","Besok mungkin akan hujan.","Hujan lagi!","Saat hujan saya suka di rumah.","Di sini sering hujan.","Mulai hujan, cepat pulang!","Hujan turun, kamu jemput anak saja."]},{"id":228,"hanzi":"下班","pinyin":"xià bān","meaning":"to finish work","idn":["Saya pulang kerja jam lima.","Kamu jam berapa pulang kerja?","Dia belum pulang kerja.","Sepulang kerja kita makan yuk.","Hari ini saya pulang kerja lebih awal.","Ayah sudah pulang kerja.","Sepulang kerja dia pergi belajar Mandarin.","Saya pulang kerja telat, kamu makan duluan saja.","Jumat sepulang kerja kita pergi main.","Kamu sudah pulang kerja?"]},{"id":229,"hanzi":"下课","pinyin":"xià kè","meaning":"to finish class","idn":["Kami sudah selesai kelas.","Jam berapa kelas selesai?","Setelah kelas selesai kami pergi makan.","Guru belum mengakhiri pelajaran.","Teman-teman, kelas selesai!","Setelah kelas saya belajar di perpustakaan.","Setelah kelas saya menunggunya di sekolah.","Hari ini kelas selesai jam lima.","Kelas sudah selesai, kita pergi yuk.","Setelah kelas kamu datang ke rumah saya."]},{"id":230,"hanzi":"下午","pinyin":"xià wǔ","meaning":"afternoon","idn":["Selamat sore!","Sore ini saya ada kelas.","Sore ini kamu main ke rumah saya yuk.","Jam tiga sore ada rapat.","Kemarin sore saya pergi ke toko.","Kita ketemu sore nanti.","Sore hari cuacanya panas.","Dia setiap sore minum teh.","Besok sore kamu ada waktu?","Sore ini saya mau tidur sebentar."]},{"id":231,"hanzi":"先生","pinyin":"xiān sheng","meaning":"Mr; Sir","idn":["Halo, Pak Li!","Apa Anda Pak Wang?","Pak Wang adalah guru kami.","Siapa bapak itu?","Pak, Anda mau pesan apa?","Pak Chen hari ini tidak datang.","Suami saya sedang bekerja.","Pak, silakan lewat sini.","Ini Pak Zhang.","Yang mana Pak Zhao?"]},{"id":232,"hanzi":"现在","pinyin":"xiàn zài","meaning":"now","idn":["Jam berapa sekarang?","Saya sekarang sedang sibuk.","Kamu sekarang di mana?","Sekarang kita pergi yuk.","Dia sekarang tidak di rumah.","Saya sekarang tidak mau makan.","Sekarang hujan turun.","Saya sekarang sedang belajar.","Sekarang cuaca sudah dingin.","Dia sekarang bekerja di rumah sakit."]},{"id":233,"hanzi":"想","pinyin":"xiǎng","meaning":"to want; to think","idn":["Saya mau minum air.","Kamu mau makan apa?","Saya tidak mau pergi lagi.","Saya mau pergi berwisata ke Cina.","Kamu kangen rumah?","Saya mau beli HP baru.","Saya kangen kamu.","Kamu mau tidak minum kopi?","Saya mau belajar bahasa Mandarin.","Saya pikir dia akan datang."]},{"id":234,"hanzi":"小","pinyin":"xiǎo","meaning":"small","idn":["Apel ini kecil.","Saya punya adik laki-laki kecil.","Anak kecil itu lucu sekali.","Rumah saya tidak besar tidak kecil.","Dia bernama Xiaoming.","Yang kecil berapa harganya?","Dia tiga tahun lebih muda dari saya.","Ini seekor burung kecil.","Ah, itu hal kecil!","Adik saya sekolah SD."]},{"id":235,"hanzi":"小朋友","pinyin":"xiǎo péng yǒu","meaning":"child","idn":["Nak, kamu umur berapa?","Anak-anak bermain di taman.","Anak ini pintar sekali.","Anak-anak semua suka bernyanyi.","Anak itu sedang menangis.","Nak, jangan lari terlalu cepat.","Di sekolah kami ada banyak anak.","Anak-anak, sudah waktunya pelajaran.","Anak ini baru lima tahun.","Nak, di mana ibumu?"]},{"id":236,"hanzi":"小时","pinyin":"xiǎo shí","meaning":"hour","idn":["Saya menunggunya dua jam.","Setiap hari tidur delapan jam.","Satu jam berapa harganya?","Naik pesawat butuh tiga jam.","Saya bekerja delapan jam sehari.","Sampai jumpa setengah jam lagi.","Saya berjalan tiga jam.","Filmnya dua jam.","Satu jam lagi pulang kerja.","Dia belajar sepuluh jam."]},{"id":237,"hanzi":"小学","pinyin":"xiǎo xué","meaning":"elementary school; primary school","idn":["Adik saya sekolah SD.","Itu SD saya.","SD ini besar sekali.","Saya belajar bahasa Inggris di SD.","Anak SD jam berapa masuk sekolah?","Dia guru SD.","Di samping rumah saya ada sebuah SD.","Apakah SD jauh dari sini?","Dia kelas dua SD.","SD saya di Beijing."]},{"id":238,"hanzi":"小学生","pinyin":"xiǎo xué shēng","meaning":"primary school student","idn":["Dia anak SD.","Anak SD masuk sekolah sangat pagi.","Anak laki-laki saya anak SD.","Anak SD setiap hari mengerjakan PR.","Anak SD itu sedang menangis.","Di sini anak SD-nya banyak.","Anak-anak SD semuanya sudah pulang.","Dia bukan anak SD lagi.","Anak SD juga suka main HP.","Dua anak SD sedang bicara."]},{"id":239,"hanzi":"些","pinyin":"xiē","meaning":"some","idn":["Saya mau beli beberapa buah.","Apel-apel ini berapa harganya?","Itu semua buku dia.","Saya bisa sedikit bahasa Mandarin.","Sebagian orang tidak suka minum teh.","Orang-orang ini semuanya saya tidak kenal.","Beberapa barang sangat mahal.","Saya membeli beberapa barang.","Yang mana saja milikmu?","Hari-hari ini saya sibuk."]},{"id":240,"hanzi":"写","pinyin":"xiě","meaning":"to write","idn":["Tolong tulis namamu.","Saya sedang menulis surat.","Karakter ini bagaimana cara menulisnya?","Dia sedang mengerjakan PR.","Saya bisa menulis huruf Mandarin.","Guru menyuruh kami menulis huruf.","Kamu menulis terlalu cepat.","Tolong tuliskan.","Saya tidak bisa menulis huruf ini.","Dia setiap hari menulis buku harian."]},{"id":241,"hanzi":"谢谢","pinyin":"xiè xie","meaning":"thank you","idn":["Terima kasih!","Terima kasih semuanya.","Terima kasih atas bantuanmu.","Tidak perlu bilang terima kasih.","Terima kasih guru sudah mengajari saya.","Terima kasih, saya sudah kenyang.","Terima kasih sudah menjemput saya.","Terima kasih sudah mentraktir saya makan.","Terima kasih atas masakan ibu.","Terima kasih atas hadiahmu."]},{"id":242,"hanzi":"新","pinyin":"xīn","meaning":"new","idn":["Ini HP baru saya.","Saya membeli baju baru.","Selamat tahun baru!","Dia teman baru saya.","Saya punya pekerjaan baru.","Sekolah barunya cantik.","Mobil barumu harganya berapa?","Kami punya rumah baru.","Tahun baru sudah tiba.","Apa ini teman sekelas baru?"]},{"id":243,"hanzi":"星期","pinyin":"xīng qī","meaning":"week","idn":["Minggu ini saya sibuk.","Hari ini hari apa?","Minggu depan kami pergi ke Shanghai.","Satu minggu ada tujuh hari.","Saya setiap hari Senin bekerja.","Minggu lalu saya sakit.","Hari Rabu kamu ada waktu?","Cuaca minggu ini bagus.","Kita ketemu hari Jumat.","Minggu ini berlalu cepat sekali."]},{"id":244,"hanzi":"星期日","pinyin":"xīng qī rì","meaning":"Sunday","idn":["Hari ini hari Minggu.","Hari Minggu kami istirahat di rumah.","Hari Minggu kamu ada waktu?","Kami pergi ke taman hari Minggu.","Minggu lalu saya pergi mengunjungi teman.","Hari Minggu toko banyak orang.","Minggu ini kamu ngapain?","Setiap hari Minggu saya pergi menjenguk ibu.","Hari Minggu tidak perlu kerja.","Hari Minggu kami sekeluarga makan bersama."]},{"id":245,"hanzi":"星期天","pinyin":"xīng qī tiān","meaning":"Sunday","idn":["Hari ini hari Minggu?","Hari Minggu saya tidak bekerja.","Hari Minggu kami main ke taman.","Minggu depan kamu datang ke rumah saya yuk.","Kemarin hari Minggu, saya istirahat di rumah.","Hari Minggu saya tidur sampai siang.","Cuaca hari Minggu bagus.","Dia setiap hari Minggu pergi ke supermarket.","Hari Minggu di jalan banyak orang.","Kalian hari Minggu buka?"]},{"id":246,"hanzi":"休息","pinyin":"xiū xi","meaning":"to rest","idn":["Hari ini saya mau istirahat.","Kamu capek, istirahat sebentar yuk.","Siang kami istirahat di kantor.","Dokter bilang saya perlu istirahat.","Hari Minggu kamu libur?","Istirahat yang baik, sampai jumpa besok.","Saya libur dua hari.","Jangan kerja lagi, istirahat sebentar.","Setelah istirahat kita pergi makan.","Dia sedang istirahat, jangan berisik."]},{"id":247,"hanzi":"学","pinyin":"xué","meaning":"to study, to learn, or knowledge","idn":["Saya sedang belajar bahasa Mandarin.","Kamu mau belajar apa?","Dia belajar menggambar di sekolah.","Setiap hari saya belajar kata baru.","Dia cepat belajar hal baru.","Adik saya sedang belajar menyetir.","Belajar bahasa Mandarin menarik tidak?","Saya belajar Mandarin dua tahun.","Dia sedang belajar menari.","Anak-anak sedang belajar menulis."]},{"id":248,"hanzi":"学生","pinyin":"xué shēng","meaning":"student","idn":["Saya pelajar.","Sekolah ini punya banyak siswa.","Para siswa semua ada di kelas.","Apa dia mahasiswa?","Siswa-siswa kami semuanya baik.","Para siswa sedang belajar Mandarin.","Siswa itu pintar sekali.","Guru bertanya kepada siswa.","Dia bukan siswa, dia guru.","Siswa setiap hari datang ke kelas."]},{"id":249,"hanzi":"学习","pinyin":"xué xí","meaning":"to learn; to study","idn":["Saya sedang belajar bahasa Mandarin.","Dia belajar dengan giat.","Kami belajar dua jam setiap hari.","Bagaimana pelajaranmu?","Belajar hal baru sangat menarik.","Jangan nonton TV lagi, pergi belajar.","Kami belajar di sekolah.","Belajar bahasa Mandarin sulit tidak?","Dia suka belajar.","Saya sekarang tidak ada waktu belajar."]},{"id":250,"hanzi":"学校","pinyin":"xué xiào","meaning":"school","idn":["Saya pergi ke sekolah.","Sekolah ini besar sekali.","Kamu kerja di sekolah mana?","Sekolah kami punya banyak guru.","Sekolah dekat dengan rumah saya.","Dia setiap hari jam tujuh pergi ke sekolah.","Anakmu sekolah di mana?","Besok sekolah tidak ada pelajaran.","Saya belajar di sekolah tiga tahun.","Ini sebuah sekolah baru."]}]
[{"id":251,"hanzi":"雪","pinyin":"xuě","meaning":"snow","idn":["Hari ini turun salju.","Lihat, saljunya besar sekali!","Saya suka salju.","Apakah besok akan turun salju?","Di luar ada salju, sangat dingin.","Salju berwarna putih.","Ayo kita pergi melihat salju.","Salju di sini sangat indah.","Kemarin turun salju.","Salju turun selama satu jam."]},{"id":252,"hanzi":"要","pinyin":"yào","meaning":"want; be going to; ask for; demand","idn":["Saya mau secangkir teh.","Kamu mau beli apa?","Saya tidak mau yang ini.","Besok saya akan pergi ke Beijing.","Dia mau belajar bahasa Mandarin.","Kamu mau minum air tidak?","Hujan turun, saya harus pulang.","Berapa harga masakan ini?","Saya mau tidur.","Dia mau ke rumah sakit menemui dokter."]},{"id":253,"hanzi":"也","pinyin":"yě","meaning":"too; also","idn":["Saya juga pelajar.","Dia juga suka minum teh.","Kamu juga bisa bicara bahasa Mandarin?","Mama juga di sini.","Saya juga tidak pergi.","Ini juga enak.","Besok saya juga tidak kerja.","Dia juga tinggal di sana.","Anjing saya juga suka kucing.","Hari ini juga dingin sekali."]},{"id":254,"hanzi":"一","pinyin":"yī","meaning":"one; once; first; structural word between two of the","idn":["Saya punya satu kakak laki-laki.","Tolong beri saya segelas air.","Dia datang bulan Januari.","Satu tahun ada dua belas bulan.","Ini harganya satu yuan.","Kita belajar sedikit demi sedikit.","Tolong tunggu sebentar.","Dia tinggal sendirian.","Buku ini sudah saya baca sekali.","Hari Senin saya pergi ke sekolah."]},{"id":255,"hanzi":"衣服","pinyin":"yī fu","meaning":"clothes","idn":["Baju ini sangat cantik.","Baju saya terlalu banyak.","Dia mau beli baju baru.","Di mana bajumu?","Berapa harga baju ini?","Hari ini dia memakai baju merah.","Baju ini terlalu besar.","Saya suka baju ini.","Mama sedang mencuci baju.","Baju-baju ini semua milik dia."]},{"id":256,"hanzi":"医生","pinyin":"yī shēng","meaning":"doctor","idn":["Dia seorang dokter.","Saya mau pergi ke dokter.","Dokter bilang saya tidak apa-apa.","Dokter ini sangat baik.","Kamu kenal dokter itu?","Ayah saya seorang dokter.","Dokter bekerja di rumah sakit.","Dia ingin menjadi dokter.","Dokter menelepon saya.","Dokter itu orang Tiongkok."]},{"id":257,"hanzi":"医院","pinyin":"yī yuàn","meaning":"hospital","idn":["Di mana rumah sakit?","Saya ke rumah sakit menjenguk teman.","Rumah sakit ini besar sekali.","Dia bekerja di rumah sakit.","Di depan rumah sakit ada toko.","Saya kemarin pergi ke rumah sakit.","Apakah rumah sakit jauh dari sini?","Dia sekarang di rumah sakit.","Kami naik mobil ke rumah sakit.","Di dalam rumah sakit ada banyak orang."]},{"id":258,"hanzi":"一半","pinyin":"yí bàn","meaning":"half","idn":["Saya makan setengahnya.","Setengah orang sudah pergi.","Apel ini saya kasih setengah untukmu.","Setengah kelas kami adalah siswi.","Dia hanya minum setengah.","Setengahnya nasi, setengahnya lauk.","Buku ini baru saya baca setengah.","Setengah uang itu milik saya.","Bulan ini sudah lewat setengah.","Setengah saja sudah cukup."]},{"id":259,"hanzi":"一下","pinyin":"yí xià","meaning":"[used after a verb] give something a go","idn":["Tolong tunggu sebentar.","Coba lihat ini sebentar.","Saya mau bertanya sebentar.","Ayo kita ngobrol sebentar.","Coba baju ini dulu.","Saya pergi sebentar lalu kembali.","Tolong katakan sebentar.","Kita istirahat sebentar.","Saya pakai HP-mu sebentar.","Dia berpikir sebentar."]},{"id":260,"hanzi":"椅子","pinyin":"yǐ zi","meaning":"chair","idn":["Silakan duduk di kursi.","Kursi ini sangat nyaman.","Kursi ada di samping meja.","Di dalam kelas ada banyak kursi.","Berapa harga kursi ini?","Dia membeli kursi baru.","Di atas kursi ada seekor kucing.","Kursi ini milik saya.","Guru duduk di kursi.","Kursinya terlalu tinggi."]},{"id":261,"hanzi":"一点儿","pinyin":"yì diǎn","meaning":"a bit","idn":["Saya bisa sedikit bahasa Mandarin.","Tolong beri saya sedikit air.","Masakan ini sedikit pedas.","Saya cuma makan sedikit.","Sedikit saja sudah cukup.","Dia bisa sedikit bahasa Inggris.","Saya mau sedikit nasi.","Hari ini tidak dingin sama sekali.","Dia tidak punya uang sama sekali.","Tolong bicara sedikit lebih pelan."]},{"id":262,"hanzi":"一些","pinyin":"yì xiē","meaning":"some","idn":["Saya membeli beberapa buah.","Dia bisa bicara sedikit bahasa Mandarin.","Di atas meja ada beberapa buku.","Saya punya beberapa pertanyaan.","Dia membeli beberapa baju.","Di sini ada sedikit nasi.","Saya membawa beberapa teh.","Sebagian orang suka minum kopi.","Tolong beri saya sedikit waktu.","Dia minta sedikit uang."]},{"id":263,"hanzi":"有","pinyin":"yǒu","meaning":"to have","idn":["Saya punya satu adik laki-laki.","Kamu punya uang tidak?","Di atas meja ada sebuah buku.","Hari ini saya tidak ada waktu.","Tiongkok punya banyak orang.","Keluarga saya ada tiga orang.","Dia punya seekor anjing.","Ada urusan apa?","Besok saya ada kelas.","Di sini ada taksi?"]},{"id":264,"hanzi":"有的","pinyin":"yǒu de","meaning":"(there are) some (who are...)","idn":["Ada orang yang suka minum teh.","Di kelas kami ada siswa yang tinggi.","Ada buku yang mahal.","Ada masakan yang pedas.","Ada orang yang bisa bicara Mandarin.","Ada apel yang berwarna merah.","Ada baju yang murah.","Bulan ini ada hari yang dingin.","Ada teman sekelas yang suka musik.","Ada film yang bagus sekali."]},{"id":265,"hanzi":"有点儿","pinyin":"yǒu diǎn","meaning":"slightly","idn":["Hari ini agak dingin.","Saya agak lelah.","Masakan ini agak pedas.","Dia agak tidak senang.","Saya agak kangen rumah.","Toko ini agak mahal.","Dia agak sedih.","Saya agak lapar.","Dia agak lambat.","Soal ini agak sulit."]},{"id":266,"hanzi":"有些","pinyin":"yǒu xiē","meaning":"some","idn":["Beberapa orang suka olahraga.","Saya ada beberapa pertanyaan untukmu.","Huruf-huruf ini agak sulit.","Beberapa hari sangat dingin.","Saya punya beberapa buku untukmu.","Beberapa anak tidak suka makan sayur.","Tempat ini agak jauh.","Saya punya beberapa teman di Tiongkok.","Beberapa baju terlalu kecil.","Hari ini ada beberapa urusan."]},{"id":267,"hanzi":"雨","pinyin":"yǔ","meaning":"rain","idn":["Hari ini hujan.","Hujannya turun deras.","Besok akan hujan?","Saya tidak suka hujan.","Di luar ada hujan.","Hujan sudah berhenti.","Hujan kemarin deras sekali.","Sedang hujan, jangan keluar.","Bulan ini hujannya banyak.","Dia berjalan di tengah hujan."]},{"id":268,"hanzi":"元","pinyin":"yuán","meaning":"yuan [unit of Chinese currency]; dollar","idn":["Ini lima yuan.","Secangkir teh sepuluh yuan.","Ini harganya dua puluh yuan.","Saya hanya punya lima puluh yuan.","Satu dolar Amerika itu berapa yuan?","Baju ini seratus yuan.","Dia memberi saya seribu yuan.","Tiga yuan sebotol air.","Buku ini delapan puluh yuan.","Terlalu mahal, dua ratus yuan!"]},{"id":269,"hanzi":"月","pinyin":"yuè","meaning":"month; moon","idn":["Bulan ini sangat sibuk.","Bulan depan saya pergi ke Tiongkok.","Satu tahun ada dua belas bulan.","Kita bertemu bulan depan.","Bulan lalu sangat dingin.","Saya lahir bulan Januari.","Dia tinggal di sini tiga bulan.","Cuaca bulan Mei sangat bagus.","Bulan ini saya belajar masak.","Bulan ini Januari."]},{"id":270,"hanzi":"再","pinyin":"zài","meaning":"again","idn":["Tolong katakan sekali lagi.","Datang lagi besok.","Saya tidak mau makan lagi.","Sampai jumpa!","Tunggu sebentar lagi.","Kita minum sedikit lagi.","Kamu pergi dulu, saya menyusul.","Jangan lupa telepon saya lagi.","Kita jumpa lagi lain waktu.","Saya mau beli lagi beberapa."]},{"id":271,"hanzi":"在","pinyin":"zài","meaning":"to be at; in; at; on","idn":["Saya di rumah.","Dia belajar di sekolah.","Kamu di mana?","Kucing di atas meja.","Saya sedang makan.","Mama memasak di rumah.","Dia sedang membaca buku.","Saya tidak di rumah.","Buku ada di kursi.","Kami tinggal di Beijing."]},{"id":272,"hanzi":"再见","pinyin":"zài jiàn","meaning":"goodbye","idn":["Sampai jumpa, sampai besok.","Kita bertemu lagi besok.","Guru sudah mengucapkan selamat tinggal.","Dadah, Ayah.","Saya tidak mau mengucapkan selamat tinggal.","Mereka mengucapkan selamat tinggal lalu pergi.","Telepon untuk mengucapkan selamat tinggal.","Sampai jumpa, temanku.","Sampai jumpa tahun depan.","Dia mengucapkan selamat tinggal."]},{"id":273,"hanzi":"早","pinyin":"zǎo","meaning":"early; morning","idn":["Selamat pagi!","Selamat pagi!","Dia bangun sangat pagi.","Hari ini saya datang lebih awal.","Selamat pagi, Guru!","Sekarang masih terlalu pagi.","Tolong datang lebih pagi sedikit.","Dia sudah pergi sejak pagi.","Sampai jumpa besok pagi.","Setelah sarapan saya pergi ke sekolah."]},{"id":274,"hanzi":"早饭","pinyin":"zǎo fàn","meaning":"breakfast","idn":["Saya sudah sarapan.","Sarapan ada di atas meja.","Kamu sudah sarapan?","Saya sarapan jam tujuh.","Mama membuat sarapan.","Saya belum sarapan.","Sarapan hari ini enak.","Dia sarapan di rumah.","Sarapan makan nasi?","Saya sarapan suka minum teh."]},{"id":275,"hanzi":"早上","pinyin":"zǎo shang","meaning":"early morning","idn":["Selamat pagi!","Saya bangun jam enam pagi.","Cuaca pagi hari sangat bagus.","Dia lari setiap pagi.","Besok pagi saya telepon kamu.","Pagi hari saya minum kopi.","Pagi ini sangat dingin.","Kami mulai kelas jam delapan pagi.","Pagi tadi saya makan roti.","Dia pergi ke sekolah pagi hari."]}]
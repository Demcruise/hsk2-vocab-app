[{"id":1,"hanzi":"爱","pinyin":"ài","meaning":"to love","idn":["Saya sayang keluarga saya.","Dia sangat menyayangi putranya.","Kamu suka minum teh?","Ayah suka menonton film.","Saya tidak suka makan masakan ini.","Mereka semua suka bernyanyi.","Kami semua sangat menyayanginya.","Ibu suka belanja di supermarket.","Dia paling suka masakan Tiongkok.","Anak kucing ini lucu sekali."]},{"id":2,"hanzi":"八","pinyin":"bā","meaning":"eight","idn":["Saya punya delapan teman.","Sekarang sudah jam delapan.","Dia pergi ke Beijing bulan Agustus.","Ini harganya delapan yuan.","Kami berdelapan makan bersama.","Tahun ini dia berumur delapan tahun.","Saya mulai kerja jam delapan pagi.","Delapan tambah dua sama dengan sepuluh.","Ulang tahunnya tanggal delapan Agustus.","Tolong beri saya delapan gelas air."]},{"id":3,"hanzi":"爸爸","pinyin":"bà ba","meaning":"father","idn":["Ayah saya seorang dokter.","Ayah sedang menonton TV.","Tahun ini ayahmu berumur berapa?","Ayah tidak di rumah.","Saya sudah menelepon ayah.","Masakan ayah enak sekali.","Besok ayah pergi ke Beijing untuk bekerja.","Ayahnya suka minum teh.","Ayah, selamat ulang tahun!","Ayah saya bisa menyetir mobil."]},{"id":4,"hanzi":"吧","pinyin":"ba","meaning":"[makes a suggestion, eg. \"Let's …\")]","idn":["Ayo kita pergi.","Kamu makan duluan saja.","Minum teh dulu, yuk.","Hari ini tidak usah pergi, besok saja.","Kamu pasti lapar, kan?","Cepat sedikit, ya.","Sudah jangan bicara terus, ayo makan.","Ini punyamu, kan?","Kita nonton TV di rumah saja.","Biarkan saya coba dulu."]},{"id":5,"hanzi":"白天","pinyin":"bái tiān","meaning":"daytime","idn":["Siang hari saya sangat sibuk.","Dia bekerja siang hari dan belajar malam hari.","Cuaca di siang hari sangat panas.","Saya di sekolah pada siang hari.","Kamu tidur di siang hari?","Siang hari saya tidak di rumah.","Siang hari banyak orang, malam hari sangat sepi.","Kita pergi siang hari saja.","Siang lebih panas daripada malam.","Siang hari dia membaca buku di rumah."]},{"id":6,"hanzi":"百","pinyin":"bǎi","meaning":"hundred","idn":["Ini harganya seratus yuan.","Sekolah kami punya lima ratus murid.","Dia punya seratus buku.","Dari sini ke sekolah tiga ratus meter.","Delapan ratus orang itu banyak.","Buku ini harganya dua ratus yuan.","Seratus tambah seratus sama dengan dua ratus.","Kamu punya uang seratus yuan?","Di pesawat ada tiga ratus orang.","Baju ini enam ratus yuan, terlalu mahal."]},{"id":7,"hanzi":"半","pinyin":"bàn","meaning":"half","idn":["Sekarang jam setengah sebelas.","Saya mau setengah gelas air.","Dia makan setengah buah apel.","Kami mulai kelas jam setengah sembilan.","Satu setengah tahun berlalu cepat.","Tahun ini adik berumur tiga setengah tahun.","Saya bangun jam setengah tujuh pagi.","Setengah bulan lagi saya pergi ke Tiongkok.","Setengah mangkuk nasi saja cukup.","Dia baru sampai rumah jam setengah delapan."]},{"id":8,"hanzi":"包子","pinyin":"bāo zi","meaning":"bao zi [steamed stuffed bun]","idn":["Bakpao ini enak sekali.","Pagi tadi saya makan dua bakpao.","Kamu mau makan bakpao?","Bakpao toko itu sangat terkenal.","Satu bakpao harganya dua yuan.","Ibu sedang membuat bakpao.","Dia tidak suka bakpao daging.","Di mana beli bakpaonya?","Besok pagi saya mau beli bakpao untuk dimakan.","Bakpaonya masih panas, makan pelan-pelan."]},{"id":9,"hanzi":"杯子","pinyin":"bēi zi","meaning":"cup; glass; mug","idn":["Ini gelas saya.","Air di dalam gelas sangat panas.","Tolong beri saya sebuah gelas.","Dia membeli gelas baru.","Di mana gelasmu?","Berapa harga gelas ini?","Di atas meja ada sebuah gelas.","Gelas saya terlalu kecil.","Dia meletakkan gelas di sana.","Gelas ini dibeli oleh ibu."]},{"id":10,"hanzi":"本","pinyin":"běn","meaning":"root; [measure word for books]","idn":["Ini sebuah buku.","Saya punya tiga buku bahasa Mandarin.","Buku ini bagus.","Berapa harga buku itu?","Saya sedang membaca sebuah buku.","Kemarin dia membeli dua buku.","Tolong berikan buku ini kepada saya.","Setiap buku harganya dua puluh yuan.","Di atas meja ada lima buku.","Saya membaca satu buku dalam seminggu."]},{"id":11,"hanzi":"边","pinyin":"biān","meaning":"side, edge, border, margin","idn":["Silakan duduk di samping saya.","Kami pergi ke pantai.","Buku ada di samping komputer.","Dia berdiri di samping pintu.","Barang-barang di sebelah sini murah.","Di sebelah sana adalah supermarket.","Sebelah kiri bank, sebelah kanan toko.","Gelas ada di tepi meja.","Di depan ada seseorang.","Dia makan sambil menonton TV."]},{"id":12,"hanzi":"病","pinyin":"bìng","meaning":"illness, disease, sickness","idn":["Dia sakit.","Ibu saya sakit, ada di rumah sakit.","Penyakitnya cukup parah.","Kamu sakit?","Adik sakit, tidak bisa ke sekolah.","Dia sudah sakit tiga hari.","Orang yang sakit harus banyak minum air.","Dia tidak datang, mungkin sakit.","Kemarin saya sakit, hari ini sudah sembuh.","Jangan khawatir, penyakit ini akan cepat sembuh."]},{"id":13,"hanzi":"不","pinyin":"bù","meaning":"not; no","idn":["Saya bukan murid.","Dia tidak pergi ke sekolah.","Ini tidak mahal.","Saya tidak kenal dia.","Besok saya tidak masuk kerja.","Kamu tidak capek?","Dia tidak suka minum teh.","Hari ini tidak terlalu dingin.","Saya bicara tidak bagus.","Dia sekarang tidak di rumah."]},{"id":14,"hanzi":"不客气","pinyin":"bú kè qi","meaning":"you're welcome; impolite","idn":["“Terima kasih!” “Sama-sama!”","Sama-sama, ini memang sudah seharusnya saya lakukan.","Dia berbicara kepadaku dengan tidak sopan.","“Terima kasih sudah membantuku.” “Sama-sama.”","Guru mengucapkan “sama-sama”.","Dia berkata “sama-sama” sambil tersenyum.","Anak itu terlalu tidak sopan.","Kamu seharusnya mengucapkan “sama-sama”.","Dia mengucapkan “sama-sama” sambil tertawa.","“Maaf sudah merepotkanmu!” “Sama-sama!”"]},{"id":15,"hanzi":"不要","pinyin":"bú yào","meaning":"don't!","idn":["Saya tidak mau yang ini.","Jangan bicara.","Barang ini gratis.","Di luar sangat dingin, jangan keluar.","Kamu jangan pergi ke sana.","Saya tidak mau teh, saya mau kopi.","Sudah terlalu malam, jangan menelepon.","Jangan makan terlalu banyak.","Uang jangan diletakkan di sini.","Jangan takut, saya di sini."]},{"id":16,"hanzi":"菜","pinyin":"cài","meaning":"vegetable","idn":["Masakan ini enak sekali.","Ibu belanja sayur di supermarket.","Kamu suka makan masakan apa?","Masakan ini terlalu pedas.","Malam ini saya yang memasak.","Masakan di restoran mahal.","Dia tidak suka makan sayur, suka makan nasi.","Kami memesan tiga macam masakan.","Apa nama masakan ini?","Masakannya sudah dingin, cepat dimakan."]},{"id":17,"hanzi":"茶","pinyin":"chá","meaning":"tea","idn":["Silakan minum teh.","Saya mau secangkir teh.","Teh Tiongkok sangat terkenal.","Ayah minum teh setiap pagi.","Tehnya agak panas.","Kamu mau minum teh atau kopi?","Secangkir teh ini berapa harganya?","Saya tidak suka minum teh.","Dia minum teh sambil membaca buku.","Minum secangkir teh di pagi hari itu enak."]},{"id":18,"hanzi":"唱","pinyin":"chàng","meaning":"to sing; to chant","idn":["Dia bernyanyi dengan merdu.","Ayo kita bernyanyi bersama.","Kamu bisa menyanyi lagu Mandarin?","Adik suka bernyanyi.","Tadi malam kami bernyanyi selama tiga jam.","Lagu apa yang sedang dia nyanyikan?","Jangan bernyanyi lagi, semuanya sedang tidur.","Dia bernyanyi lebih baik daripada saya.","Burung kecil bernyanyi di atas pohon.","Saya ingin belajar menyanyikan lagu ini."]},{"id":19,"hanzi":"超市","pinyin":"chāo shì","meaning":"supermarket","idn":["Saya pergi ke supermarket untuk belanja.","Di mana supermarketnya?","Supermarket ini besar.","Ibu pergi ke supermarket setiap hari.","Di dalam supermarket ada banyak orang.","Kita bertemu di depan supermarket saja.","Barang-barang di supermarket murah.","Supermarket tidak jauh dari rumah.","Dia sudah pergi ke supermarket beli susu.","Supermarket ini tutup jam sepuluh malam."]},{"id":20,"hanzi":"车","pinyin":"chē","meaning":"vehicle, wheeled conveyance","idn":["Saya naik kendaraan pergi kerja.","Mobil siapa ini?","Dia punya mobil baru.","Kendaraannya sudah datang, ayo pergi.","Ayah saya bisa menyetir.","Hari ini kendaraan di jalan banyak sekali.","Berapa harga mobil ini?","Besok saya ingin membeli mobil.","Dia menunggu kendaraan di halte.","Naik kereta ke Beijing sangat praktis."]},{"id":21,"hanzi":"吃","pinyin":"chī","meaning":"to eat","idn":["Kamu sudah makan?","Saya ingin makan masakan Tiongkok.","Dia sedang makan.","Jangan makan ini, terlalu pedas.","Ayo kita makan malam bersama.","Masakan ibu enak sekali.","Apa yang kamu makan untuk sarapan?","Saya tidak makan cabai.","Sudah kenyang, terima kasih.","Besok saya traktir kamu makan."]},{"id":22,"hanzi":"出租车","pinyin":"chū zū chē","meaning":"taxi","idn":["Saya naik taksi ke bandara.","Di mana taksinya?","Kita naik taksi saja ke sana.","Taksi terlalu mahal.","Dia memanggil sebuah taksi.","Sopir taksinya orangnya baik.","Saya pulang naik taksi.","Sedang hujan, naik taksi saja.","Dari sini naik taksi biayanya berapa?","Taksinya datang, ayo naik."]},{"id":23,"hanzi":"穿","pinyin":"chuān","meaning":"to wear; to put on","idn":["Hari ini dingin, pakai baju lebih tebal.","Dia memakai baju merah.","Kamu pakai sepatu ukuran berapa?","Baju ini terlalu kecil, saya tidak bisa memakainya.","Dia sedang berpakaian.","Besok pakai baju apa?","Apa saya terlihat bagus pakai baju ini?","Cepat pakai baju, kita mau berangkat.","Hari ini dia memakai baju baru.","Sepatu ini nyaman dipakai."]},{"id":24,"hanzi":"打电话","pinyin":"dǎ diàn huà","meaning":"to make a telephone call","idn":["Saya menelepon ibu.","Tolong telepon saya.","Dia sedang menelepon.","Kamu menelepon siapa?","Nanti saya telepon kamu.","Jangan menelepon lagi, sebentar lagi masuk kelas.","Dokter bilang besok akan meneleponnya.","Saya menelepon ibu setiap hari.","Saya menelepon pakai ponsel.","Setelah sampai rumah, telepon saya."]},{"id":25,"hanzi":"大","pinyin":"dà","meaning":"big","idn":["Rumah saya besar.","Beijing adalah kota besar.","Kamu umur berapa?","Apel ini besar.","Hujannya turun sangat deras.","Gelas ini terlalu besar.","Kakak laki-laki saya tiga tahun lebih tua dari saya.","Angin hari ini kencang.","Supermarket itu tidak besar.","Kalau sudah besar, saya ingin jadi dokter."]}]
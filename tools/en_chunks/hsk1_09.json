[{"id":201,"hanzi":"它","pinyin":"tā","meaning":"it","idn":["Itu anjing saya.","Lihat, dia sedang tidur.","Saya sangat menyukainya.","Namanya siapa?","Kucing saya berwarna putih, dia cantik sekali.","Dia ada di bawah meja.","Dia tidak mau makan ini.","Kamu melihatnya tidak?","Itu kucing teman saya.","Di luar hujan, dia tidak bisa keluar."]},{"id":202,"hanzi":"她","pinyin":"tā","meaning":"she; her","idn":["Dia guru saya.","Apa dia di rumah?","Dia bekerja di rumah sakit.","Dia tidak suka makan apel.","Kemarin dia pergi ke Beijing.","Apa dia bisa bahasa Mandarin?","Dia kakak perempuan saya.","Hari ini dia senang sekali.","Saya kenal dia.","Sekarang dia sedang menelepon."]},{"id":203,"hanzi":"他们","pinyin":"tā men","meaning":"they","idn":["Mereka teman sekelas saya.","Mereka sedang ngapain?","Mereka semua suka masakan Cina.","Kemarin mereka pergi nonton film.","Apa mereka guru?","Saya tidak kenal mereka.","Mereka tinggal di Beijing.","Besok mereka akan datang ke rumah saya.","Mereka semua sibuk.","Saya bekerja bersama mereka."]},{"id":204,"hanzi":"它们","pinyin":"tā men","meaning":"they (for inanimate objects)","idn":["Di mana buku-buku saya? Semuanya di sini.","Semuanya milik saya.","Semuanya cantik sekali.","Lihat burung-burung itu, mereka sedang terbang.","Semuanya baru.","Semuanya terlalu mahal, saya tidak jadi beli.","Semuanya ada di toko.","Saya sudah menaruh semuanya di atas meja.","Semuanya bukan buku saya.","Saya memakan semuanya."]},{"id":205,"hanzi":"她们","pinyin":"tā men","meaning":"they","idn":["Mereka kakak-kakak perempuan saya.","Mereka belajar di sekolah.","Mereka semua suka bernyanyi.","Apa mereka orang Cina?","Mereka datang kemarin.","Saya tidak kenal mereka.","Mereka sedang minum kopi.","Mereka rekan kerja saya.","Besok mereka pulang.","Mereka semua cantik."]},{"id":206,"hanzi":"太","pinyin":"tài","meaning":"very","idn":["Hari ini panas sekali.","Ini terlalu mahal.","Kamu baik sekali.","Dia terlalu sibuk, tidak ada waktu untuk pergi.","Segelas air ini terlalu dingin.","Bagus sekali!","Kamu bangun terlalu siang.","Orang itu terlalu tinggi.","Hari ini tidak terlalu dingin.","Dia bicara terlalu cepat."]},{"id":207,"hanzi":"天","pinyin":"tiān","meaning":"sky, heaven, or the celestial realm","idn":["Hari ini saya senang sekali.","Kemarin hari Minggu.","Kamu besok ada waktu?","Dia kemarin tidak datang.","Sehari ada berapa jam?","Setiap hari saya bekerja di rumah.","Beberapa hari ini dingin sekali.","Hari sudah gelap, pulang yuk.","Hari itu dia tidak di rumah.","Besok kami pergi ke Beijing."]},{"id":208,"hanzi":"天气","pinyin":"tiān qì","meaning":"weather","idn":["Cuaca hari ini bagus.","Bagaimana cuaca besok?","Cuaca di Beijing dingin sekali.","Cuaca terlalu panas, saya mau minum air.","Cuaca di sini selalu hujan.","Cuaca hari ini buruk, kita tidak jadi ke taman.","Kamu suka cuaca di sini?","Cuaca sudah dingin, pakai baju lebih.","Besok cuaca akan dingin tidak?","Cuaca beberapa hari ini lumayan bagus."]},{"id":209,"hanzi":"听","pinyin":"tīng","meaning":"to listen; hear","idn":["Saya sedang mendengarkan musik.","Tolong dengarkan saya.","Kamu suka mendengar lagu apa?","Dia tidak menuruti kata guru.","Kami mendengarkan dua lagu.","Saya tidak mengerti apa yang saya dengar.","Dengar, itu suara apa?","Dia sedang mendengarkan guru bicara.","Besok saya mau dengar kamu menyanyi.","Kamu setiap hari mendengarkan musik?"]},{"id":210,"hanzi":"听见","pinyin":"tīng jiàn","meaning":"to hear","idn":["Kamu dengar tidak?","Saya mendengar suara burung.","Dia tidak mendengar apa yang saya katakan.","Terlalu berisik, saya tidak mendengar kamu bicara.","Saya dengar ada orang memanggil saya.","Dia mendengar apa?","Kamu dengar suara itu tidak?","Saya dengar dia sedang menelepon.","Saya mendengar suara hujan.","Guru mendengar kami bicara."]},{"id":211,"hanzi":"同学","pinyin":"tóng xué","meaning":"schoolmate; classmate","idn":["Dia teman sekelas saya.","Teman-teman sekelas saya semuanya baik.","Teman-teman, selamat pagi!","Kamu punya berapa teman sekelas?","Saya pergi ke sekolah bersama teman sekelas.","Dia teman SD saya.","Teman, siapa namamu?","Teman-teman sekelas kami semua suka dia.","Saya makan siang bersama teman.","Teman sekelas itu tidak jadi datang."]},{"id":212,"hanzi":"外","pinyin":"wài","meaning":"outside","idn":["Di luar panas sekali.","Dia menunggu saya di luar.","Di luar hujan.","Saya bekerja di luar negeri.","Di luar pintu ada orang.","Jangan main di luar sampai terlalu malam.","Mobil di luar terlalu banyak.","Saya mau makan di luar.","Orang asing juga sedang belajar bahasa Mandarin.","Tolong tunggu saya di luar sebentar."]},{"id":213,"hanzi":"外边","pinyin":"wài bian","meaning":"outside","idn":["Di luar hujan.","Anak-anak bermain di luar.","Di luar dingin, jangan keluar.","Dia berdiri di luar.","Ada suara apa di luar?","Kita keluar yuk, cuaca di luar bagus.","Kamu tunggu di luar sebentar.","Mobil di luar itu milik saya.","Jangan bicara di luar.","Anjing menggonggong di luar."]},{"id":214,"hanzi":"玩","pinyin":"wán","meaning":"to play","idn":["Kita main ke taman yuk.","Anak-anak bermain di luar.","Kamu suka main apa?","Kemarin saya main dengan senang.","Dia sedang main game komputer.","Jangan main lagi, kerjakan PR.","Besok main ke rumah saya.","Mereka bermain di pantai seharian.","Kamu bisa main game ini?","Akhir pekan saya mau main keluar."]},{"id":215,"hanzi":"晚","pinyin":"wǎn","meaning":"evening, night, late","idn":["Hari ini saya bangun kesiangan.","Kemarin dia tidur sangat larut.","Sekarang sudah terlalu malam, kita pergi yuk.","Kamu malam ini ada waktu?","Jangan pulang terlalu malam.","Malam hari saya belajar di rumah.","Dia setiap malam menonton TV.","Sekarang sudah larut.","Makan malam kamu mau makan apa?","Tadi malam dia tidak di rumah."]},{"id":216,"hanzi":"晚饭","pinyin":"wǎn fàn","meaning":"evening meal","idn":["Kami makan malam jam tujuh.","Kamu sudah makan malam?","Makan malam makan apa?","Ibu memasak makan malam.","Saya mentraktir teman makan malam.","Makan malam hari ini enak sekali.","Dia belum makan malam.","Setelah makan malam kami nonton TV.","Kita makan malam di luar yuk.","Untuk makan malam saya mau makan mi."]},{"id":217,"hanzi":"晚上","pinyin":"wǎn shang","meaning":"evening","idn":["Selamat malam!","Kamu malam hari ngapain?","Saya belajar bahasa Mandarin di malam hari.","Malam ini nonton film yuk.","Dia tidur jam sepuluh malam.","Tadi malam hujan.","Besok malam kamu ada waktu?","Malam hari di luar sangat sepi.","Kami makan bersama di malam hari.","Ayah malam ini tidak pulang makan."]},{"id":218,"hanzi":"喂","pinyin":"wèi","meaning":"hello","idn":["Halo!","Halo, boleh tahu ini siapa?","Halo, ini Xiaoming.","Halo, kamu bisa dengar saya?","Halo, kamu cari siapa?","Halo, ibu di rumah?","Halo, tunggu sebentar.","Halo, ini guru?","Halo, sampai jumpa besok.","Dia mengangkat telepon dan berkata, “Halo?”"]},{"id":219,"hanzi":"问","pinyin":"wèn","meaning":"to ask","idn":["Saya mau tanya kamu satu pertanyaan.","Kamu tanya guru saja.","Dia bertanya banyak hal kepada saya.","Jangan tanya terlalu banyak.","Permisi, di mana kamar mandi?","Ibu bertanya saya mau makan apa.","Tanya dia saja, dia tahu.","Boleh saya tanya satu pertanyaan?","Guru mengajukan satu pertanyaan kepada saya.","Kamu sudah tanya jalan?"]},{"id":220,"hanzi":"问题","pinyin":"wèn tí","meaning":"problem","idn":["Saya punya satu pertanyaan.","Pertanyaan ini terlalu sulit.","Tidak masalah, kamu boleh pergi.","Kamu masih ada pertanyaan?","Apa jawaban pertanyaan ini?","Tidak masalah!","Guru, saya ada pertanyaan.","Pertanyaan ini gampang.","Semua pertanyaannya saya tidak tahu.","Sekarang ada masalah apa?"]},{"id":221,"hanzi":"我","pinyin":"wǒ","meaning":"I; me","idn":["Saya pelajar.","Saya suka minum teh.","Tahun ini saya berumur dua puluh lima tahun.","Senang berkenalan denganmu.","Besok saya tidak pergi ke sekolah.","Dia menelepon saya.","Saya tidak makan daging.","Keluarga saya ada tiga orang.","Tolong beri saya segelas air.","Saya bisa sedikit bahasa Mandarin."]},{"id":222,"hanzi":"我们","pinyin":"wǒ men","meaning":"we; us","idn":["Kami teman baik.","Kita pergi yuk.","Kita ketemu besok.","Kita makan bersama yuk.","Kami semua tidak suka dia.","Kami menunggumu di rumah.","Sekolah kami besar.","Kemarin kami pergi ke toko.","Kamu ikut pergi bersama kami?","Kami akan datang lagi."]},{"id":223,"hanzi":"五","pinyin":"wǔ","meaning":"five","idn":["Saya punya lima apel.","Sekarang jam lima.","Dia berumur lima tahun.","Saya beli lima gelas teh.","Hari ini tanggal lima bulan Mei.","Kami berlima makan.","Ini lima yuan.","Dia lima menit lagi datang.","Hari Jumat kami tidak ada pelajaran.","Satu dua tiga empat lima, saya bisa berhitung."]},{"id":224,"hanzi":"午饭","pinyin":"wǔ fàn","meaning":"lunch","idn":["Kamu sudah makan siang?","Kami makan siang jam dua belas.","Makan siang kamu mau makan apa?","Makan siang hari ini enak.","Saya makan siang di sekolah.","Dia belum makan siang.","Waktu makan siang sudah tiba.","Saya makan siang bersama rekan kerja.","Setelah makan siang saya minum secangkir teh.","Makan siang kamu yang traktir?"]},{"id":225,"hanzi":"喜欢","pinyin":"xǐ huan","meaning":"to like","idn":["Saya suka kamu.","Kamu suka makan apa?","Dia tidak suka minum teh.","Saya suka menonton film.","Kamu suka tidak sama dia?","Dia sangat suka kucing itu.","Kami semua suka guru.","Saya suka akhir pekan.","Dia suka belanja.","Saya suka tempat ini."]}]
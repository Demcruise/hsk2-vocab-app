[{"id":26,"hanzi":"大家","pinyin":"dà jiā","meaning":"everybody","idn":["Halo semuanya!","Semuanya sudah datang?","Terima kasih semuanya.","Semuanya makan bersama.","Semuanya sedang menunggumu.","Semua orang menyukainya.","Mohon semuanya tenang.","Semuanya dengarkan saya.","Selamat pagi semuanya.","Semuanya jangan sungkan, makanlah."]},{"id":27,"hanzi":"大学","pinyin":"dà xué","meaning":"university","idn":["Saya kuliah.","Universitas ini sangat terkenal.","Dia belajar di Universitas Peking.","Adik perempuan saya tahun depan masuk kuliah.","Di mana kampusmu?","Saya belajar bahasa Mandarin di universitas.","Kehidupan kuliah itu sibuk.","Berapa banyak mahasiswa di universitas ini?","Dia seorang dosen.","Saya ingin kuliah di universitas Tiongkok."]},{"id":28,"hanzi":"大学生","pinyin":"dà xué shēng","meaning":"university student","idn":["Saya mahasiswa.","Kakak laki-lakinya adalah mahasiswa.","Kehidupan mahasiswa itu sibuk.","Para mahasiswa ini sedang belajar bahasa Mandarin.","Apakah adikmu mahasiswa?","Apakah mahasiswa semuanya tinggal di kampus?","Kelas kami ada dua puluh mahasiswa.","Mahasiswa itu berasal dari Tiongkok.","Tahun depan saya sudah jadi mahasiswa.","Mahasiswa mulai kelas jam delapan pagi."]},{"id":29,"hanzi":"到","pinyin":"dào","meaning":"to arrive; to get to","idn":["Saya sudah sampai rumah.","Kereta sudah tiba.","Kapan kamu sampai?","Kami sudah tiba di Beijing.","Dari sini ke sana butuh sepuluh menit.","Dia belum sampai.","Saya tiba besok.","Jam berapa pesawat tiba di Shanghai?","Musim dingin tiba, cuaca jadi dingin.","Saya menunggumu satu jam barulah kamu sampai."]},{"id":30,"hanzi":"的","pinyin":"de","meaning":"of","idn":["Ini buku saya.","Dia teman saya.","Gelas yang merah itu milik saya.","Kucingmu lucu sekali.","Cuaca hari ini bagus.","Masakan Tiongkok enak.","Mobil ibu saya baru.","Bakpao yang dia beli enak.","Barang siapa ini?","Rumah saya di samping universitas."]},{"id":31,"hanzi":"第","pinyin":"dì","meaning":"sequence prefix (ordinal number marker)","idn":["Ini pertama kalinya saya datang ke Tiongkok.","Dia mendapat juara pertama.","Hari ini hari pertama masuk kelas.","Gelas ketiga adalah milik saya.","Kamu yang keberapa datang?","Ini pertama kalinya saya naik pesawat.","Dia adalah guru pertama saya.","Ini kedua kalinya saya bertemu dengannya.","Buku pertama sangat menarik.","Kami duduk di baris kedua."]},{"id":32,"hanzi":"弟弟","pinyin":"dì di","meaning":"younger brother","idn":["Adik laki-laki saya berumur lima tahun.","Adik sedang tidur.","Kamu punya adik laki-laki?","Adik saya suka makan apel.","Tahun ini adik masuk SD.","Adik saya lebih tinggi daripada saya.","Dik, jangan menangis.","Adik saya sedang belajar bahasa Mandarin.","Adik sakit, ada di rumah sakit.","Ini foto saya dan adik."]},{"id":33,"hanzi":"点","pinyin":"diǎn","meaning":"o’clock; spot; dot","idn":["Sekarang jam berapa?","Sekarang jam tiga.","Kita bertemu jam delapan.","Film mulai jam lima.","Kamu bangun jam berapa?","Sudah jam sembilan.","Saya tidur jam sepuluh malam.","Sudah hampir jam tujuh, ayo pergi.","Dia tiba jam sepuluh pagi.","Lima menit lagi jam delapan."]},{"id":34,"hanzi":"店","pinyin":"diàn","meaning":"shop, store, inn","idn":["Toko ini besar.","Di depan ada sebuah restoran.","Toko ini tutup jam berapa?","Bakpao toko itu enak.","Di dalam toko ada banyak orang.","Dia bekerja di toko ini.","Di mana toko buku?","Barang-barang di toko ini mahal.","Malam hari toko itu tidak buka.","Ibu saya bekerja di sebuah toko sepatu."]},{"id":35,"hanzi":"电话","pinyin":"diàn huà","meaning":"telephone","idn":["Berapa nomor teleponmu?","Saya sedang menelepon.","Tolong beri saya nomor teleponmu.","Dia sudah menelepon saya.","Telepon ini milik saya.","Saya menerima telepon, lalu langsung keluar.","Telepon dari siapa?","Kamu ingat nomor teleponnya?","Di telepon suaranya tidak jelas.","Setiap hari saya memakai telepon untuk bicara dengan keluarga."]},{"id":36,"hanzi":"电脑","pinyin":"diàn nǎo","meaning":"computer","idn":["Saya punya sebuah komputer.","Komputer ini mahal.","Dia sedang bekerja dengan komputer.","Komputer saya rusak.","Dia belanja lewat komputer.","Jangan main lagi, matikan komputernya.","Saya ingin membeli komputer baru.","Di mana komputernya?","Adik belajar dengan komputer setiap hari.","Komputernya cepat."]},{"id":37,"hanzi":"电视","pinyin":"diàn shì","meaning":"TV","idn":["Saya sedang menonton TV.","Malam hari kami menonton TV.","Jangan nonton TV lagi, kerjakan PR.","TV-nya terlalu besar.","Acara TV ini bagus.","Ayah suka menonton berita di TV.","TV-nya masih menyala.","Di TV dibilang hari ini akan hujan.","Berapa harga TV ini?","Dia melihat gurunya di TV."]},{"id":38,"hanzi":"电影","pinyin":"diàn yǐng","meaning":"film; movie","idn":["Ayo kita pergi nonton film.","Film ini bagus.","Kamu mau nonton film apa?","Tadi malam saya menonton sebuah film.","Film mulai jam berapa?","Dia suka menonton film Tiongkok.","Film ini terlalu lama.","Kami menonton satu film bersama.","Di dalam bioskop orangnya tidak banyak.","Film itu saya belum pernah tonton."]},{"id":39,"hanzi":"电影院","pinyin":"diàn yǐng yuàn","meaning":"cinema; movie theater","idn":["Di mana bioskopnya?","Kita pergi ke bioskop menonton film.","Bioskop ini besar.","Sampai jumpa di depan bioskop.","Di dalam bioskop ada banyak orang.","Bioskop itu baru dibuka.","Bioskop sangat dekat dengan rumah saya.","Sabtu malam kita pergi ke bioskop.","Tiket bioskopnya mahal tidak?","Saya bertemu teman di bioskop."]},{"id":40,"hanzi":"东西","pinyin":"dōng xi","meaning":"thing","idn":["Kamu beli apa?","Di mana barang-barang saya?","Berapa harga barang ini?","Jangan ambil barang saya.","Barang-barang di supermarket murah.","Saya membeli banyak barang.","Barang ini terlalu berat.","Tolong letakkan barangnya di atas meja.","Dia datang tanpa membawa barang apa pun.","Barang-barang ini semua punyamu?"]},{"id":41,"hanzi":"都","pinyin":"dōu","meaning":"both; all","idn":["Kami semua menyukainya.","Mereka semua adalah murid.","Semua masakan ini saya suka makan.","Semuanya sedang tidur.","Saya bisa mengerjakan apa saja.","Hari ini atau besok dua-duanya bisa.","Barang-barangnya semua tidak mahal.","Apakah mereka semua sudah datang?","Setiap minggu saya pulang ke rumah.","Kami berdua sama-sama tidak minum kopi."]},{"id":42,"hanzi":"读","pinyin":"dú","meaning":"read aloud","idn":["Tolong baca kalimat ini.","Dia sedang membaca koran.","Silakan ikuti saya membaca.","Saya membaca tidak lancar.","Guru menyuruh kami membaca teks pelajaran.","Tolong baca dengan suara keras.","Kamu bisa membaca karakter ini?","Bagaimana cara membaca karakter ini?","Dia membaca buku satu jam setiap hari.","Anak-anak sedang membaca cerita."]},{"id":43,"hanzi":"读书","pinyin":"dú shū","meaning":"to read a book","idn":["Saya suka membaca buku.","Dia sedang membaca di dalam kamar.","Adik membaca buku setiap hari.","Jangan bicara, saya sedang membaca.","Ayo kita pergi membaca di perpustakaan.","Membaca lebih menarik daripada nonton TV.","Malam hari saya sering membaca.","Adik perempuan berkuliah di universitas.","Dia membaca buku setiap malam.","Anak ini suka membaca."]},{"id":44,"hanzi":"对","pinyin":"duì","meaning":"correct; right","idn":["Yang kamu katakan benar.","Dia benar, saya salah.","Maaf, saya salah.","Minum teh baik untuk tubuh.","Dia baik terhadap saya.","Yang kamu katakan benar atau tidak?","Buku ini bagus untuk belajar bahasa Mandarin.","Saya membeli sepasang sepatu.","Kalian benar.","Di seberang ada sebuah bank."]},{"id":45,"hanzi":"对不起","pinyin":"duì bu qǐ","meaning":"sorry","idn":["Maaf, saya datang terlambat.","Maaf, boleh tanya halte di mana?","Dia mengucapkan maaf.","Maaf, saya tidak bisa mendengar.","Kamu tidak mau minta maaf?","Maaf, ini bukan milik saya.","Maaf sekali, sudah membuatmu menunggu selama ini.","Dia mengucapkan maaf berkali-kali.","Maaf, saya tidak mendengar dengan jelas.","Katakan maaf kepadanya."]},{"id":46,"hanzi":"多","pinyin":"duō","meaning":"many; much; more than; how","idn":["Di sini ada banyak orang.","Hari ini panas, minumlah lebih banyak air.","Orangnya terlalu banyak.","Saya harus lebih banyak makan sayur.","Kamu umur berapa?","Makanlah lebih banyak.","Orang kami tidak banyak, cuma tiga.","Barang di dalam supermarket banyak.","Kemarin tidurnya banyak, hari ini tidak capek.","Pakailah lebih banyak baju, di luar sangat dingin."]},{"id":47,"hanzi":"多少","pinyin":"duō shao","meaning":"how much/many?","idn":["Ini berapa harganya?","Kamu punya berapa uang?","Di sini ada berapa murid?","Satu hari ada berapa jam?","Buku ini harganya berapa?","Berapa orang di keluargamu?","Kamu sudah belajar bahasa Mandarin berapa tahun?","Secangkir teh berapa harganya?","Berapa orang yang mau pergi?","Sebotol air ini berapa harganya?"]},{"id":48,"hanzi":"儿子","pinyin":"ér zi","meaning":"son","idn":["Dia putra saya.","Putra saya tahun ini berumur sepuluh tahun.","Dia punya seorang putra.","Putra saya sedang bersekolah.","Putranya lucu sekali.","Besok putra ujian, sekarang sedang belajar.","Di mana putramu bekerja?","Putra suka makan masakan ibu.","Putranya seorang mahasiswa.","Ibu sangat menyayangi putranya."]},{"id":49,"hanzi":"二","pinyin":"èr","meaning":"two","idn":["Hari ini tanggal 5 Februari.","Saya tinggal di lantai dua.","Sekarang jam 12.20.","Tahun ini dia berumur dua puluh dua tahun.","Saya tanggal 12 pergi ke Beijing.","Dua tambah dua sama dengan empat.","Dia pulang hari Selasa.","Ini kedua kalinya.","Di lantai dua ada toko buku.","Ulang tahun saya bulan Februari."]},{"id":50,"hanzi":"饭","pinyin":"fàn","meaning":"cooked rice or food in general","idn":["Kamu sudah makan?","Kita pergi makan bersama.","Ibu sedang memasak.","Makanannya sudah matang, cepat makan.","Saya sarapan makan bakpao.","Makanan di restoran ini enak.","Makan siang makan apa?","Dia makan tiga kali sehari.","Makanannya masih panas, tunggu sebentar.","Setelah makan saya harus bekerja."]}]